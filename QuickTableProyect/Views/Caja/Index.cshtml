@{
    ViewBag.Title = "Pedidos Activos - Caja";
}

<link rel="stylesheet" href="~/AdminLTE/plugins/sweetalert2/sweetalert2.min.css">
<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        }

    .collapse {
        transition: height 0.35s ease;
    }

    .clickable-card {
        cursor: pointer;
        user-select: none;
    }

    .card-footer button {
        z-index: 10;
        position: relative;
    }

    .content-wrapper {
        margin-left: 1% !important;
        margin-right: 1% !important;
    }
    /* Selector visual de metodo de pago */
    .metodo-btn {
        color: #6c757d;
        background: #fff;
        border-color: #dee2e6 !important;
        user-select: none;
    }

    input[type="radio"]:checked + .metodo-btn {
        background: #d4edda;
        border-color: #28a745 !important;
        color: #155724;
        font-weight: 800 !important;
    }
</style>
<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1><i class="fas fa-cash-register"></i> @ViewBag.Title</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Inicio</a></li>
                        <li class="breadcrumb-item active">Pedidos Activos</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row mb-3">
                <div class="col-12 text-center">
                    <a href="@Url.Action("Historial", "Caja")" class="btn btn-info btn-lg">
                        <i class="fas fa-history"></i> Ver Historial
                    </a>
                </div>
            </div>

            <div class="row justify-content-center" id="pedidosContainer">
                <!-- Los pedidos se cargarán aquí -->
            </div>
        </div>
    </section>
</div>

<!-- Modal Finalizar Pedido -->
<div class="modal fade" id="finalizarPedidoModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;overflow:hidden;border:none;box-shadow:0 20px 60px rgba(0,0,0,.22);">

            <!-- CABECERA -->
            <div class="modal-header" style="background:linear-gradient(135deg,#155724,#28a745);border-bottom:none;padding:16px 24px;">
                <div class="d-flex align-items-center" style="gap:10px;">
                    <div style="width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-cash-register" style="color:#fff;font-size:1rem;"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" style="color:#fff;font-weight:800;font-size:1rem;">Finalizar Pedido</h5>
                        <small id="pedidoInfo" style="color:rgba(255,255,255,.75);font-size:.78rem;"></small>
                    </div>
                </div>
                <button type="button" class="close" data-dismiss="modal" style="color:#fff;opacity:.8;font-size:1.4rem;margin-top:-4px;">
                    <span>&times;</span>
                </button>
            </div>

            <input type="hidden" id="pedidoId">

            <!-- CUERPO EN DOS COLUMNAS -->
            <div class="modal-body p-0">
                <div class="row no-gutters">

                    <!-- COLUMNA IZQUIERDA: resumen de importes -->
                    <div class="col-md-5" style="background:#f8f9fa;padding:20px 22px;border-right:1px solid #e9ecef;">

                        <p class="text-uppercase font-weight-bold mb-3"
                           style="font-size:.7rem;letter-spacing:.08em;color:#6c757d;">
                            <i class="fas fa-receipt mr-1"></i> Resumen
                        </p>

                        <!-- Total original -->
                        <div style="background:#fff;border-radius:10px;padding:14px 16px;margin-bottom:12px;border:1px solid #e2e8f0;">
                            <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#6c757d;margin-bottom:4px;">
                                Total Sin Propina
                            </div>
                            <div id="totalOriginal" style="font-size:1.5rem;font-weight:900;color:#2c5fba;line-height:1;"></div>
                        </div>

                        <!-- Propina -->
                        <div style="background:#fff;border-radius:10px;padding:14px 16px;margin-bottom:12px;border:1px solid #e2e8f0;">
                            <label for="propinaPorcentaje"
                                   style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#6c757d;margin-bottom:6px;display:block;">
                                <i class="fas fa-percentage mr-1"></i> Propina (%)
                            </label>
                            <input type="number"
                                   class="form-control"
                                   id="propinaPorcentaje"
                                   value="5" min="0" max="100"
                                   style="border-radius:8px;font-size:1.1rem;font-weight:800;text-align:center;border:2px solid #dee2e6;">
                        </div>

                        <!-- Total a cobrar -->
                        <div style="background:linear-gradient(135deg,#e9f5ee,#d4edda);border-radius:10px;padding:16px;border:1px solid #a3d9b1;">
                            <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#155724;margin-bottom:4px;">
                                <i class="fas fa-check-circle mr-1"></i> Total a cobrar
                            </div>
                            <div id="totalConPropina" style="font-size:1.75rem;font-weight:900;color:#155724;line-height:1;"></div>
                        </div>

                    </div>

                    <!-- COLUMNA DERECHA: metodo de pago + efectivo -->
                    <div class="col-md-7" style="background:#fff;padding:20px 22px;">

                        <p class="text-uppercase font-weight-bold mb-3"
                           style="font-size:.7rem;letter-spacing:.08em;color:#6c757d;">
                            <i class="fas fa-credit-card mr-1"></i> Metodo de pago
                        </p>

                        <!-- Select oculto — la logica lo sigue usando sin cambios -->
                        <select class="d-none" id="metodoPago">
                            <option value="QR">QR</option>
                            <option value="Tarjeta">Tarjeta</option>
                            <option value="Efectivo">Efectivo</option>
                        </select>

                        <!-- Selector visual horizontal -->
                        <div class="d-flex mb-4" style="gap:10px;">
                            <label class="flex-fill mb-0" style="cursor:pointer;">
                                <input type="radio" name="metodoPagoRad" value="QR" checked style="display:none;">
                                <div class="metodo-btn text-center border rounded p-2"
                                     style="transition:.18s;font-size:.82rem;font-weight:700;">
                                    <i class="fas fa-qrcode d-block mb-1" style="font-size:1.4rem;"></i> QR
                                </div>
                            </label>
                            <label class="flex-fill mb-0" style="cursor:pointer;">
                                <input type="radio" name="metodoPagoRad" value="Tarjeta" style="display:none;">
                                <div class="metodo-btn text-center border rounded p-2"
                                     style="transition:.18s;font-size:.82rem;font-weight:700;">
                                    <i class="fas fa-credit-card d-block mb-1" style="font-size:1.4rem;"></i> Tarjeta
                                </div>
                            </label>
                            <label class="flex-fill mb-0" style="cursor:pointer;">
                                <input type="radio" name="metodoPagoRad" value="Efectivo" style="display:none;">
                                <div class="metodo-btn text-center border rounded p-2"
                                     style="transition:.18s;font-size:.82rem;font-weight:700;">
                                    <i class="fas fa-money-bill-wave d-block mb-1" style="font-size:1.4rem;"></i> Efectivo
                                </div>
                            </label>
                        </div>

                        <!-- Seccion efectivo -->
                        <div id="efectivoGroup" style="display:none;">

                            <div style="background:#f8f9fa;border-radius:10px;padding:14px 16px;border:1px solid #e2e8f0;margin-bottom:12px;">
                                <label for="efectivoRecibido"
                                       style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#6c757d;margin-bottom:8px;display:block;">
                                    <i class="fas fa-hand-holding-usd mr-1"></i> Efectivo recibido
                                </label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"
                                              style="background:#e9ecef;border-radius:8px 0 0 8px;font-weight:800;font-size:1rem;border-color:#dee2e6;">
                                            $
                                        </span>
                                    </div>
                                    <input type="text"
                                           class="form-control"
                                           id="efectivoRecibido"
                                           placeholder="0"
                                           autocomplete="off"
                                           inputmode="numeric"
                                           style="border-radius:0 8px 8px 0;font-size:1.2rem;font-weight:800;border-color:#dee2e6;text-align:right;">
                                </div>
                            </div>

                            <!-- Cambio -->
                            <div style="background:linear-gradient(135deg,#d1ecf1,#bee5eb);border-radius:10px;padding:14px 16px;border:1px solid #a8d8e0;">
                                <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#0c5460;margin-bottom:4px;">
                                    <i class="fas fa-exchange-alt mr-1"></i> Cambio
                                </div>
                                <div id="cambioCalculado"
                                     style="font-size:1.5rem;font-weight:900;color:#0c5460;line-height:1;">
                                    $0
                                </div>
                            </div>

                        </div>

                        <!-- Placeholder cuando no es efectivo -->
                        <div id="pagoDigitalMsg" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:130px;color:#adb5bd;">
                            <i class="fas fa-shield-alt" style="font-size:2.2rem;margin-bottom:10px;"></i>
                            <span style="font-size:.85rem;font-weight:600;">Pago digital — sin vuelto</span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- PIE -->
            <div class="modal-footer" style="background:#f0f0f0;border-top:1px solid #e0e0e0;padding:14px 24px;">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"
                        style="border-radius:8px;font-weight:600;min-width:100px;">
                    <i class="fas fa-times mr-1"></i> Cancelar
                </button>
                <button type="button" class="btn btn-success" onclick="confirmarFinalizacion()"
                        style="border-radius:8px;font-weight:800;min-width:140px;background:linear-gradient(135deg,#155724,#28a745);border:none;">
                    <i class="fas fa-check mr-1"></i> Finalizar
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminLTE/plugins/sweetalert2/sweetalert2.min.js"></script>
    <script>
        let pedidoSeleccionado = null;
        let estadosExpandidos = {};

        $(document).ready(function() {
            loadPedidos();
            setInterval(loadPedidos, 5000);

            // Sincronizar selector visual con el select oculto
            $('input[name="metodoPagoRad"]').on('change', function() {
                $('#metodoPago').val($(this).val()).trigger('change');
            });

            $('#metodoPago').change(function() {
                if ($(this).val() === 'Efectivo') {
                    $('#efectivoGroup').show();
                    $('#pagoDigitalMsg').hide();
                } else {
                    $('#efectivoGroup').hide();
                     $('#pagoDigitalMsg').show();
                    $('#efectivoRecibido').val('');
                    $('#cambioCalculado').text('$0');
                }
            });

            // Formato de miles colombiano en el campo de efectivo
            $('#efectivoRecibido').on('input', function() {
                let raw = $(this).val().replace(/\D/g, '');
                if (raw === '') {
                    $(this).val('');
                } else {
                    $(this).val(parseInt(raw, 10).toLocaleString('es-CO'));
                }
                calcularTotales();
            });

            $('#propinaPorcentaje').on('input', calcularTotales);
        });

        function loadPedidos() {
            $.ajax({
                url: '@Url.Action("ObtenerPedidosActivos", "Caja")',
                type: 'GET',
                success: function(data) {
                    renderPedidos(data);
                },
                error: function(xhr, status, error) {
                    console.log('Error al cargar datos:', error);
                }
            });
        }

        function renderPedidos(items) {
            const container = $('#pedidosContainer');

            // Guardar estado de expansión actual antes de re-renderizar
            $('.collapse').each(function() {
                const id = $(this).attr('id');
                estadosExpandidos[id] = $(this).hasClass('show');
            });

            container.empty();

            if (items.length === 0) {
                container.append('<div class="col-12"><p class="text-center">No hay pedidos activos</p></div>');
                return;
            }

            $.each(items, function(index, item) {
                const cardColor = item.estado === 'Listo' ? 'card-success' : 'card-warning';
                const badgeColor = item.estado === 'Listo' ? 'success' : 'warning';
                const collapseId = `pedido-${item.id}`;
                const isExpanded = estadosExpandidos[collapseId] || false;

                const card = `
                    <div class="col-12 col-sm-6 col-lg-4 mb-3">
                        <div class="card ${cardColor} card-outline">
                            <div class="card-header clickable-card" data-pedido-id="${item.id}">
                                <h3 class="card-title">
                                    <i class="fas fa-utensils"></i> Mesa ${item.numeroMesa}
                                </h3>
                                <div class="card-tools">
                                    <span class="badge badge-${badgeColor}">${item.estado}</span>
                                    <button type="button" class="btn btn-tool toggle-icon">
                                        <i class="fas fa-angle-${isExpanded ? 'up' : 'down'}"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-3 clickable-card" data-pedido-id="${item.id}">
                                <dl class="row mb-0">
                                    <dt class="col-5">Pedido #:</dt>
                                    <dd class="col-7">${item.id}</dd>

                                    <dt class="col-5">Mesero:</dt>
                                    <dd class="col-7">${item.meseroNombre}</dd>

                                    <dt class="col-5">Total:</dt>
                                    <dd class="col-7"><strong class="text-lg">$${item.total.toLocaleString('es-CO')}</strong></dd>
                                </dl>
                            </div>
                            <div id="${collapseId}" class="collapse ${isExpanded ? 'show' : ''}">
                                <div class="card-body pt-0">
                                    <hr>
                                    <h6 class="text-bold">Detalles del Pedido:</h6>
                                    <table class="table table-sm table-hover">
                                        <thead>
                                            <tr>
                                                <th>Plato</th>
                                                <th class="text-center">Cant.</th>
                                                <th class="text-right">Subtotal</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            ${item.detalles.map(d => `
                                                <tr>
                                                    <td>${d.nombre}</td>
                                                    <td class="text-center">${d.cantidad}</td>
                                                    <td class="text-right">$${d.subtotal.toLocaleString('es-CO')}</td>
                                                </tr>
                                            `).join('')}
                                        </tbody>
                                    </table>
                                    <div class="totales">
                                        <div class="row">
                                            <div class="col-6">Subtotal:</div>
                                            <div class="col-6 text-right">$${item.subtotal.toLocaleString('es-CO')}</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">IVA (19%):</div>
                                            <div class="col-6 text-right">$${item.iva.toLocaleString('es-CO')}</div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-6"><strong>Total:</strong></div>
                                            <div class="col-6 text-right"><strong class="text-lg">$${item.total.toLocaleString('es-CO')}</strong></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <button class="btn btn-success btn-block" onclick="abrirModalFinalizar(event, ${JSON.stringify(item).replace(/"/g, '&quot;')})">
                                    <i class="fas fa-check"></i> Finalizar Pedido
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                container.append(card);
            });

            // Agregar event listeners para hacer click en toda la tarjeta
            $('.clickable-card').off('click').on('click', function(e) {
                const pedidoId = $(this).data('pedido-id');
                const collapseElement = $(`#pedido-${pedidoId}`);
                const toggleIcon = $(this).closest('.card').find('.toggle-icon i');

                collapseElement.collapse('toggle');

                // Cambiar ícono
                setTimeout(() => {
                    if (collapseElement.hasClass('show')) {
                        toggleIcon.removeClass('fa-angle-down').addClass('fa-angle-up');
                    } else {
                        toggleIcon.removeClass('fa-angle-up').addClass('fa-angle-down');
                    }
                }, 100);
            });
        }

        function abrirModalFinalizar(event, pedido) {
            event.stopPropagation();
            pedidoSeleccionado = pedido;
            $('#pedidoId').val(pedido.id);
            $('#pedidoInfo').text(`Pedido #${pedido.id} - Mesa ${pedido.numeroMesa}`);
            $('#totalOriginal').text('$' + pedido.total.toLocaleString('es-CO'));
            $('#totalConPropina').text('$' + pedido.total.toLocaleString('es-CO'));
            $('#propinaPorcentaje').val(0);

            // Resetear selector visual al primer metodo
            $('input[name="metodoPagoRad"][value="QR"]').prop('checked', true);
            // Disparar el change para actualizar los estilos del selector visual
            $('input[name="metodoPagoRad"][value="QR"]').trigger('change');

            $('#efectivoGroup').hide();
            $('#pagoDigitalMsg').show();
            $('#efectivoRecibido').val('');
            $('#cambioCalculado').text('$0');

            $('#finalizarPedidoModal').modal('show');
        }

        function calcularTotales() {
            if (!pedidoSeleccionado) return;

            const propinaPorcentaje = parseFloat($('#propinaPorcentaje').val()) || 0;
            const propina = pedidoSeleccionado.total * (propinaPorcentaje / 100);
            const totalConPropina = pedidoSeleccionado.total + propina;

            $('#totalConPropina').text('$' + totalConPropina.toLocaleString('es-CO'));

            if ($('#metodoPago').val() === 'Efectivo') {
                // Quitar puntos de formato antes de parsear
                const efectivoRaw = parseFloat($('#efectivoRecibido').val().replace(/\./g, '').replace(',', '.')) || 0;
                const cambio = efectivoRaw - totalConPropina;
                $('#cambioCalculado').text('$' + (cambio >= 0 ? cambio.toLocaleString('es-CO') : '0'));
            }
        }

        function confirmarFinalizacion() {
            const propinaPorcentaje = parseFloat($('#propinaPorcentaje').val()) || 0;
            const propina = pedidoSeleccionado.total * (propinaPorcentaje / 100);
            const totalConPropina = pedidoSeleccionado.total + propina;
            const metodoPago = $('#metodoPago').val();
            let efectivoRecibido = 0;
            let cambio = 0;

            if (metodoPago === 'Efectivo') {
                // Quitar puntos de formato antes de parsear
                efectivoRecibido = parseFloat($('#efectivoRecibido').val().replace(/\./g, '').replace(',', '.')) || 0;
                if (efectivoRecibido < totalConPropina) {
                    toastr.error('El efectivo recibido es insuficiente');
                    return;
                }
                cambio = efectivoRecibido - totalConPropina;
            }

            $.ajax({
                url: '@Url.Action("FinalizarPedido", "Caja")',
                type: 'POST',
                data: {
                    pedidoId: pedidoSeleccionado.id,
                    propina: propina,
                    metodoPago: metodoPago,
                    efectivoRecibido: efectivoRecibido,
                    cambio: cambio
                },
                success: function(response) {
                    if (response.success) {
                        $('#finalizarPedidoModal').modal('hide');
                        toastr.success('Pedido finalizado correctamente');
                        if (response.facturaUrl) {
                            window.open(response.facturaUrl, '_blank');
                        }
                        loadPedidos();
                    } else {
                        toastr.error(response.message || 'Error al finalizar pedido');
                    }
                },
                error: function() {
                    toastr.error('Error de conexion');
                }
            });
        }
    </script>
}