@{
    ViewBag.Title = "Historial de Pedidos";
}

<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        }

    .collapse {
        transition: height 0.35s ease;
    }

    .clickable-card {
        cursor: pointer;
        user-select: none;
    }

    .content-wrapper {
        margin-left: 1% !important;
        margin-right: 1% !important;
    }

    /* Vista tabla */
    #tablaHistorial { font-size: 0.88rem; }
    #tablaHistorial .fila-pedido { cursor: pointer; }
    #tablaHistorial .fila-pedido:hover { filter: brightness(0.96); }
    #tablaHistorial .detalle-fila td { padding: 0; background: #f8f9fa; }
    .btn-vista.active { box-shadow: inset 0 2px 4px rgba(0,0,0,0.25); }
</style>
<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1><i class="fas fa-history"></i> @ViewBag.Title</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Caja")">Pedidos Activos</a></li>
                        <li class="breadcrumb-item active">Historial</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <!-- Botón Volver -->
            <div class="row mb-3">
                <div class="col-12">
                    <a href="@Url.Action("Index", "Caja")" class="btn btn-info">
                        <i class="fas fa-arrow-left"></i> Volver a Pedidos Activos
                    </a>
                </div>
            </div>

            <!-- Filtros -->
            <div class="row mb-3">
                <div class="col-12">
                    <div class="card card-primary card-outline">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-filter"></i> Filtros de Búsqueda</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <label for="fechaFiltro">Fecha:</label>
                                    <input type="date" class="form-control" id="fechaFiltro">
                                </div>
                                <div class="col-md-3">
                                    <label for="pedidoIdFiltro">Número de Pedido:</label>
                                    <input type="number" class="form-control" id="pedidoIdFiltro" min="1">
                                </div>
                                <div class="col-md-3">
                                    <label for="meseroIdFiltro">ID Mesero:</label>
                                    <input type="number" class="form-control" id="meseroIdFiltro" min="1">
                                </div>
                                <div class="col-md-3 align-self-end">
                                    <button class="btn btn-primary btn-block" id="btnBuscar">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Barra de vista -->
            <div class="d-flex justify-content-end mb-2">
                <div class="btn-group" role="group">
                    <button id="btnVistaCards" class="btn btn-sm btn-primary btn-vista active" onclick="cambiarVista('cards')" title="Vista tarjetas">
                        <i class="fas fa-th-large"></i> Tarjetas
                    </button>
                    <button id="btnVistaTabla" class="btn btn-sm btn-outline-primary btn-vista" onclick="cambiarVista('tabla')" title="Vista tabla">
                        <i class="fas fa-table"></i> Tabla
                    </button>
                </div>
            </div>

            <!-- Vista tarjetas -->
            <div class="row justify-content-center" id="pedidosContainer"></div>

            <!-- Vista tabla -->
            <div id="tablaContainer" style="display:none; overflow-x:auto;">
                <table class="table table-bordered table-hover table-sm mb-0" id="tablaHistorial">
                    <thead class="thead-light">
                        <tr>
                            <th>#</th>
                            <th>Mesa</th>
                            <th>Mesero</th>
                            <th>Fecha / Hora</th>
                            <th>Pago</th>
                            <th class="text-right">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tablaBody"></tbody>
                </table>
            </div>

            <!-- Paginación -->
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <!-- Paginación se cargará aquí -->
                </ul>
            </nav>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        var _currentView = 'cards';

        function cambiarVista(vista) {
            _currentView = vista;
            if (vista === 'cards') {
                $('#pedidosContainer').show();
                $('#tablaContainer').hide();
                $('#btnVistaCards').removeClass('btn-outline-primary').addClass('btn-primary active');
                $('#btnVistaTabla').removeClass('btn-primary active').addClass('btn-outline-primary');
            } else {
                $('#pedidosContainer').hide();
                $('#tablaContainer').show();
                $('#btnVistaTabla').removeClass('btn-outline-primary').addClass('btn-primary active');
                $('#btnVistaCards').removeClass('btn-primary active').addClass('btn-outline-primary');
            }
            // re-render con los datos actuales si ya están cargados
            if (window._ultimosDatos) renderPedidosGlobal(window._ultimosDatos);
        }

        $(document).ready(function () {
            var pageNumber = 1;
            var pageSize = 8;
            var totalPedidos = 0;
            var estadosExpandidos = {};

            function loadPedidos() {
                var fecha = $('#fechaFiltro').val();
                var pedidoId = $('#pedidoIdFiltro').val();
                var meseroId = $('#meseroIdFiltro').val();

                $.ajax({
                    url: '@Url.Action("ObtenerHistorialPedidos", "Caja")',
                    type: 'GET',
                    data: {
                        pageNumber: pageNumber,
                        pageSize: pageSize,
                        fecha: fecha,
                        pedidoId: pedidoId ? parseInt(pedidoId) : null,
                        meseroId: meseroId ? parseInt(meseroId) : null
                    },
                    success: function (data) {
                        totalPedidos = data.totalPedidos;
                        window._ultimosDatos = data.pedidos;
                        renderPedidosGlobal(data.pedidos);
                        renderPagination();
                    },
                    error: function (xhr, status, error) {
                        console.log('Error al cargar datos: ' + error);
                        toastr.error('Error al cargar el historial');
                    }
                });
            }

            function parseFecha(item) {
                if (!item.fechaHora) return 'Sin fecha';
                var partes = item.fechaHora.split(' ');
                var fechaPartes = partes[0].split('/');
                var horaPartes = partes[1].split(':');
                var d = new Date(
                    parseInt(fechaPartes[2]),
                    parseInt(fechaPartes[1]) - 1,
                    parseInt(fechaPartes[0]),
                    parseInt(horaPartes[0]),
                    parseInt(horaPartes[1])
                );
                return d.toLocaleDateString('es-CO', { day:'2-digit', month:'2-digit', year:'numeric' })
                     + ' ' + d.toLocaleTimeString('es-CO', { hour:'2-digit', minute:'2-digit' });
            }

            function renderPedidosGlobal(items) {
                if (_currentView === 'tabla') renderTabla(items);
                else renderCards(items);
            }

            function renderTabla(items) {
                var tbody = $('#tablaBody');
                tbody.empty();
                if (items.length === 0) {
                    tbody.html('<tr><td colspan="7"><div class="alert alert-info mb-0"><i class="fas fa-info-circle"></i> No hay pedidos en el historial</div></td></tr>');
                    return;
                }
                $.each(items, function(i, item) {
                    var metodoPagoColor = item.metodoPago === 'Efectivo' ? 'success' :
                                         item.metodoPago === 'Tarjeta'  ? 'info'    : 'primary';
                    var total = parseFloat(item.total + item.propina).toLocaleString('es-CO');
                    var fecha = parseFecha(item);

                    // Detalle items
                    var detalleItems = item.detalles.map(function(d) {
                        return `<tr>
                            <td>${d.nombre}</td>
                            <td class="text-center">${d.cantidad}</td>
                            <td class="text-right">$${parseFloat(d.valor).toLocaleString('es-CO')}</td>
                            <td class="text-right">$${parseFloat(d.subtotal).toLocaleString('es-CO')}</td>
                        </tr>`;
                    }).join('');

                    var propinaRow = item.propina > 0
                        ? `<div class="row"><div class="col-6">Propina:</div><div class="col-6 text-right">$${parseFloat(item.propina).toLocaleString('es-CO')}</div></div>`
                        : '';
                    var efectivoRows = item.metodoPago === 'Efectivo'
                        ? `<hr><div class="row"><div class="col-6">Efectivo recibido:</div><div class="col-6 text-right">$${parseFloat(item.efectivoRecibido).toLocaleString('es-CO')}</div></div>
                           <div class="row"><div class="col-6">Cambio:</div><div class="col-6 text-right">$${parseFloat(item.cambio).toLocaleString('es-CO')}</div></div>`
                        : '';

                    tbody.append(`
                        <tr class="fila-pedido" onclick="toggleFilaTabla(${item.id}, this)">
                            <td><strong>#${item.id}</strong></td>
                            <td>Mesa ${item.numeroMesa}</td>
                            <td>${item.meseroNombre}</td>
                            <td style="white-space:nowrap;">${fecha}</td>
                            <td><span class="badge badge-${metodoPagoColor}">${item.metodoPago}</span></td>
                            <td class="text-right text-success font-weight-bold">$${total}</td>
                            <td class="text-center"><i class="fas fa-chevron-down text-muted" id="ico-t-${item.id}"></i></td>
                        </tr>
                        <tr class="detalle-fila" id="det-t-${item.id}" style="display:none;">
                            <td colspan="7">
                                <div class="p-3">
                                    <table class="table table-sm table-hover mb-2">
                                        <thead><tr><th>Plato</th><th class="text-center">Cant.</th><th class="text-right">Valor</th><th class="text-right">Subtotal</th></tr></thead>
                                        <tbody>${detalleItems}</tbody>
                                    </table>
                                    <div class="row justify-content-end" style="font-size:0.9rem;">
                                        <div class="col-auto text-right">
                                            <div>Subtotal: <strong>$${parseFloat(item.subtotal).toLocaleString('es-CO')}</strong></div>
                                            <div>IVA (19%): <strong>$${parseFloat(item.iva).toLocaleString('es-CO')}</strong></div>
                                            ${propinaRow}
                                            <hr class="my-1">
                                            <div><strong>Total: <span class="text-success">$${total}</span></strong></div>
                                            ${efectivoRows}
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    `);
                });
            }

            function renderPedidos(items) {
                renderCards(items);
            }

            function renderCards(items) {
                var container = $('#pedidosContainer');

                // Guardar estados expandidos
                $('.collapse').each(function() {
                    var id = $(this).attr('id');
                    estadosExpandidos[id] = $(this).hasClass('show');
                });

                container.empty();

                if (items.length === 0) {
                    container.append('<div class="col-12"><div class="alert alert-info"><i class="fas fa-info-circle"></i> No hay pedidos en el historial</div></div>');
                    return;
                }

                $.each(items, function (index, item) {
                    var metodoPagoColor = item.metodoPago === 'Efectivo' ? 'success' :
                                         item.metodoPago === 'Tarjeta' ? 'info' : 'primary';
                    var collapseId = 'historial-' + item.id;
                    var isExpanded = estadosExpandidos[collapseId] || false;

                    var fechaFormato = parseFecha(item);



                    var card = `
                        <div class="col-12 col-sm-6 col-lg-4 mb-3">
                            <div class="card card-info card-outline">
                                <div class="card-header clickable-card" data-historial-id="${item.id}">
                                    <h3 class="card-title">
                                        <i class="fas fa-utensils"></i> Mesa ${item.numeroMesa}
                                    </h3>
                                    <div class="card-tools">
                                        <span class="badge badge-${metodoPagoColor}">${item.metodoPago}</span>
                                        <button type="button" class="btn btn-tool toggle-icon">
                                            <i class="fas fa-angle-${isExpanded ? 'up' : 'down'}"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body p-3 clickable-card" data-historial-id="${item.id}">
                                    <dl class="row mb-0">
                                        <dt class="col-5">Pedido #:</dt>
                                        <dd class="col-7">${item.id}</dd>

                                        <dt class="col-5">ID Mesero:</dt>
                                        <dd class="col-7">${item.meseroId}</dd>

                                        <dt class="col-5">Mesero:</dt>
                                        <dd class="col-7">${item.meseroNombre}</dd>

                                        <dt class="col-5">Fecha:</dt>
                                        <dd class="col-7">${fechaFormato}</dd>

                                        <dt class="col-5">Total:</dt>
                                        <dd class="col-7"><strong class="text-lg">$${parseFloat(item.total + item.propina).toLocaleString('es-CO')}</strong></dd>
                                    </dl>
                                </div>
                                <div id="${collapseId}" class="collapse ${isExpanded ? 'show' : ''}">
                                    <div class="card-body pt-0">
                                        <hr>
                                        <h6 class="text-bold">Detalles del Pedido:</h6>
                                        <table class="table table-sm table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Plato</th>
                                                    <th class="text-center">Cant.</th>
                                                    <th class="text-right">Valor</th>
                                                    <th class="text-right">Subtotal</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${item.detalles.map(d => `
                                                    <tr>
                                                        <td>${d.nombre}</td>
                                                        <td class="text-center">${d.cantidad}</td>
                                                        <td class="text-right">$${parseFloat(d.valor).toLocaleString('es-CO')}</td>
                                                        <td class="text-right">$${parseFloat(d.subtotal).toLocaleString('es-CO')}</td>
                                                    </tr>
                                                `).join('')}
                                            </tbody>
                                        </table>
                                        <div class="totales">
                                            <div class="row">
                                                <div class="col-6">Subtotal:</div>
                                                <div class="col-6 text-right">$${parseFloat(item.subtotal).toLocaleString('es-CO')}</div>
                                            </div>
                                            <div class="row">
                                                <div class="col-6">IVA (19%):</div>
                                                <div class="col-6 text-right">$${parseFloat(item.iva).toLocaleString('es-CO')}</div>
                                            </div>
                                            ${item.propina > 0 ? `
                                            <div class="row">
                                                <div class="col-6">Propina:</div>
                                                <div class="col-6 text-right">$${parseFloat(item.propina).toLocaleString('es-CO')}</div>
                                            </div>
                                            ` : ''}
                                            <hr>
                                            <div class="row">
                                                <div class="col-6"><strong>Total Pagado:</strong></div>
                                                <div class="col-6 text-right"><strong class="text-lg">$${parseFloat(item.total + item.propina).toLocaleString('es-CO')}</strong></div>
                                            </div>
                                            ${item.metodoPago === 'Efectivo' ? `
                                            <hr>
                                            <div class="row">
                                                <div class="col-6">Efectivo Recibido:</div>
                                                <div class="col-6 text-right">$${parseFloat(item.efectivoRecibido).toLocaleString('es-CO')}</div>
                                            </div>
                                            <div class="row">
                                                <div class="col-6">Cambio:</div>
                                                <div class="col-6 text-right">$${parseFloat(item.cambio).toLocaleString('es-CO')}</div>
                                            </div>
                                            ` : ''}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    container.append(card);
                });

                // Event listeners para acordeón
                $('.clickable-card').off('click').on('click', function(e) {
                    var historialId = $(this).data('historial-id');
                    var collapseElement = $('#historial-' + historialId);
                    var toggleIcon = $(this).closest('.card').find('.toggle-icon i');

                    collapseElement.collapse('toggle');

                    setTimeout(function() {
                        if (collapseElement.hasClass('show')) {
                            toggleIcon.removeClass('fa-angle-down').addClass('fa-angle-up');
                        } else {
                            toggleIcon.removeClass('fa-angle-up').addClass('fa-angle-down');
                        }
                    }, 100);
                });
            }

            function renderPagination() {
                var totalPages = Math.ceil(totalPedidos / pageSize);
                var pagination = $('.pagination');
                pagination.empty();

                var firstPageItem = $('<li class="page-item ' + (pageNumber === 1 ? 'disabled' : '') + '"><a class="page-link" href="#">Primera</a></li>');
                firstPageItem.click(function () {
                    if (pageNumber !== 1) {
                        pageNumber = 1;
                        loadPedidos();
                    }
                });
                pagination.append(firstPageItem);

                var prevPageItem = $('<li class="page-item ' + (pageNumber === 1 ? 'disabled' : '') + '"><a class="page-link" href="#">Anterior</a></li>');
                prevPageItem.click(function () {
                    if (pageNumber > 1) {
                        pageNumber--;
                        loadPedidos();
                    }
                });
                pagination.append(prevPageItem);

                var maxPagesToShow = 5;
                var startPage = Math.max(1, pageNumber - Math.floor(maxPagesToShow / 2));
                var endPage = Math.min(totalPages, startPage + maxPagesToShow - 1);

                for (var i = startPage; i <= endPage; i++) {
                    var li = $('<li class="page-item ' + (i === pageNumber ? 'active' : '') + '"><a class="page-link" href="#">' + i + '</a></li>');
                    li.click(function () {
                        pageNumber = parseInt($(this).text());
                        loadPedidos();
                    });
                    pagination.append(li);
                }

                var nextPageItem = $('<li class="page-item ' + (pageNumber === totalPages ? 'disabled' : '') + '"><a class="page-link" href="#">Siguiente</a></li>');
                nextPageItem.click(function () {
                    if (pageNumber < totalPages) {
                        pageNumber++;
                        loadPedidos();
                    }
                });
                pagination.append(nextPageItem);

                var lastPageItem = $('<li class="page-item ' + (pageNumber === totalPages ? 'disabled' : '') + '"><a class="page-link" href="#">Última</a></li>');
                lastPageItem.click(function () {
                    if (pageNumber !== totalPages) {
                        pageNumber = totalPages;
                        loadPedidos();
                    }
                });
                pagination.append(lastPageItem);
            }

            $('#btnBuscar').click(function () {
                pageNumber = 1;
                loadPedidos();
            });

            loadPedidos();
        });

        function toggleFilaTabla(id) {
            var row = $('#det-t-' + id);
            var ico = $('#ico-t-' + id);
            if (row.is(':visible')) {
                row.hide();
                ico.removeClass('fa-chevron-up').addClass('fa-chevron-down');
            } else {
                row.show();
                ico.removeClass('fa-chevron-down').addClass('fa-chevron-up');
            }
        }
    </script>

}
