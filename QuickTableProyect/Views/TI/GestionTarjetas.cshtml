@model IEnumerable<QuickTableProyect.Dominio.TarjetaRC>
@{
    ViewBag.Title = "Gestión de Tarjetas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!--puta vida -->
<link rel="stylesheet" href="~/AdminLTE/plugins/toastr/toastr.min.css">
<link rel="stylesheet" href="~/AdminLTE/plugins/sweetalert2/sweetalert2.min.css">

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>@ViewBag.Title</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                        <li class="breadcrumb-item active">Gestión de Tarjetas</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row mb-3">
                <div class="col-12">
                    <a asp-action="CrearAdministrador" class="btn btn-success btn-lg">
                        <i class="fas fa-user-plus"></i> Crear Administrador
                    </a>
                </div>
            </div>

            <div class="row">
                @foreach (var t in Model)
                {
                    <div class="col-12 col-md-6 col-lg-4 mb-3">
                        <div class="card @(t.Activa ? "card-success" : "card-warning") card-outline">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fas @(t.Activa ? "fa-check-circle" : "fa-clock")"></i>
                                    @t.Empleado?.Nombre
                                </h3>
                                <div class="card-tools">
                                    @if (t.Activa)
                                    {
                                        <span class="badge badge-success">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">Pendiente</span>
                                    }
                                </div>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4">ID:</dt>
                                    <dd class="col-sm-8">@t.Id</dd>

                                    <dt class="col-sm-4">UID:</dt>
                                    <dd class="col-sm-8"><code>***PROTEGIDO***</code></dd>

                                    <dt class="col-sm-4">Fecha:</dt>
                                    <dd class="col-sm-8">@(t.FechaAsignacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                                </dl>
                            </div>
                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-12 col-sm-4 mb-2 mb-sm-0">
                                        <button class="btn btn-warning btn-block btn-sm" onclick="mostrarModalCambiarClave(@t.EmpleadoId, '@t.Empleado.Nombre')" title="Cambiar Contraseña">
                                            <i class="fas fa-key"></i>
                                        </button>
                                    </div>

                                    <div class="col-12 col-sm-4 mb-2 mb-sm-0">
                                        @if (!t.Activa)
                                        {
                                            <button type="button" class="btn btn-primary btn-block btn-sm" onclick="mostrarCodigoSesion('@t.Uid', '@t.Empleado.Nombre')" title="Crear Tarjeta">
                                                <i class="fas fa-sd-card"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-info btn-block btn-sm" onclick="regenerarTarjeta(@t.EmpleadoId)" title="Regenerar Tarjeta">
                                                <i class="fas fa-redo"></i>
                                            </button>
                                        }
                                    </div>

                                    <div class="col-12 col-sm-4">
                                        <button class="btn btn-danger btn-block btn-sm" onclick="eliminarAdministrador(@t.EmpleadoId, '@t.Empleado.Nombre')" title="Eliminar Administrador">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

<!-- Modal Cambiar Contraseña -->
<div class="modal fade" id="modalCambiarClave" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">Cambiar Contraseña</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="formCambiarClave">
                <div class="modal-body">
                    <p>Administrador: <strong id="nombreAdmin"></strong></p>
                    <input type="hidden" id="adminIdCambio">
                    <div class="form-group">
                        <label class="form-label">Nueva Contraseña</label>
                        <input type="password" id="nuevaClave" class="form-control" required minlength="4">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Confirmar Contraseña</label>
                        <input type="password" id="confirmarClave" class="form-control" required minlength="4">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">Cambiar Contraseña</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para mostrar código de sesión -->
<div class="modal fade" id="codigoSesionModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Código de Sesión</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-1">Administrador: <strong id="adminNombreModal"></strong></p>
                <p class="mb-3 text-muted">UID: <code id="uidModal"></code></p>
                <p class="text-muted mb-2">Ingrese este código en el módulo para grabar la tarjeta:</p>
                <div id="codigoSesionDisplay" style="font-size:2.8rem;font-weight:700;color:#007bff;letter-spacing:10px;font-family:monospace;"></div>
                <div class="mt-4">
                    <p class="mb-1 text-muted"><i class="fas fa-clock"></i> El código expira en:</p>
                    <span id="tiCountdownDisplay" style="font-size:2rem;font-weight:700;color:#ffc107;">10:00</span>
                </div>
                <div id="tiPiStatus" class="mt-3" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminLTE/plugins/sweetalert2/sweetalert2.min.js"></script>

    <script>
        $(document).ready(function() {
            @if (TempData["Ok"] != null)
            {
                            <text>
                            toastr.success('@TempData["Ok"]');
                            </text>
            }

            @if (TempData["Error"] != null)
            {
                            <text>
                            toastr.error('@TempData["Error"]');
                            </text>
            }
        });

        let _tiCountdownInterval = null;
        let _tiPollingInterval = null;

        function _tiStopTimers() {
            clearInterval(_tiCountdownInterval);
            clearInterval(_tiPollingInterval);
            _tiCountdownInterval = null;
            _tiPollingInterval = null;
        }

        function _tiSetStatus(tipo, msg) {
            const el = document.getElementById('tiPiStatus');
            const map = {
                success: { bg: '#d4edda', color: '#155724', border: '#c3e6cb' },
                error:   { bg: '#f8d7da', color: '#721c24', border: '#f5c6cb' },
                warning: { bg: '#fff3cd', color: '#856404', border: '#ffeeba' }
            };
            const s = map[tipo] || map.warning;
            el.innerHTML = `<div style="padding:10px;border-radius:5px;background:${s.bg};color:${s.color};border:1px solid ${s.border};">${msg}</div>`;
            el.style.display = 'block';
        }

        function mostrarCodigoSesion(uid, adminNombre) {
            const codigo = Math.floor(Math.random() * 900000 + 100000);
            fetch('@Url.Action("AsociarCodigoSesion", "TI")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ uid: uid, codigoSesion: codigo.toString() })
            })
            .then(r => r.json())
            .then(d => {
                if (!d.success) { toastr.error(d.message); return; }

                document.getElementById('adminNombreModal').textContent = adminNombre;
                document.getElementById('uidModal').textContent = uid;
                document.getElementById('codigoSesionDisplay').textContent = codigo;
                document.getElementById('tiPiStatus').style.display = 'none';
                document.getElementById('tiPiStatus').innerHTML = '';

                const countdownEl = document.getElementById('tiCountdownDisplay');
                countdownEl.textContent = '10:00';
                countdownEl.style.color = '#ffc107';

                $('#codigoSesionModal').modal('show');

                // Countdown 10 min (orientativo, el servidor no expira este código automáticamente)
                let remaining = 10 * 60;
                function tick() {
                    const m = Math.floor(remaining / 60);
                    const s = remaining % 60;
                    countdownEl.textContent = String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
                    if (remaining <= 60) countdownEl.style.color = '#dc3545';
                    if (remaining <= 0) {
                        _tiStopTimers();
                        _tiSetStatus('warning', 'Tiempo agotado. Regenere la tarjeta si la Pi aún no la grabó.');
                        setTimeout(() => $('#codigoSesionModal').modal('hide'), 3000);
                        return;
                    }
                    remaining--;
                }
                tick();
                _tiCountdownInterval = setInterval(tick, 1000);

                // Polling: detectar cuando la Pi confirma la grabación
                _tiPollingInterval = setInterval(() => {
                    fetch('/api/tarjeta/estado?uid=' + encodeURIComponent(uid))
                        .then(r => r.json())
                        .then(activa => {
                            if (activa === true) {
                                _tiStopTimers();
                                _tiSetStatus('success', '✓ Tarjeta grabada y activada correctamente por la Pi.');
                                setTimeout(() => {
                                    $('#codigoSesionModal').modal('hide');
                                    location.reload();
                                }, 2500);
                            }
                        })
                        .catch(() => {});
                }, 3000);
            })
            .catch(error => {
                toastr.error('Error de conexión');
                console.error('Error:', error);
            });
        }

        $('#codigoSesionModal').on('hidden.bs.modal', function() {
            _tiStopTimers();
            document.getElementById('tiCountdownDisplay').textContent = '10:00';
            document.getElementById('tiCountdownDisplay').style.color = '#ffc107';
            document.getElementById('tiPiStatus').style.display = 'none';
        });

        function mostrarModalCambiarClave(id, nombre) {
            document.getElementById('adminIdCambio').value = id;
            document.getElementById('nombreAdmin').textContent = nombre;
            document.getElementById('nuevaClave').value = '';
            document.getElementById('confirmarClave').value = '';
            $('#modalCambiarClave').modal('show');
        }

        document.getElementById('formCambiarClave').addEventListener('submit', function(e) {
            e.preventDefault();
            const nueva = document.getElementById('nuevaClave').value;
            const confirmar = document.getElementById('confirmarClave').value;
            const adminId = document.getElementById('adminIdCambio').value;

            if (nueva !== confirmar) {
                toastr.error('Las contraseñas no coinciden');
                return;
            }

            if (nueva.length < 4) {
                toastr.error('La contraseña debe tener al menos 4 caracteres');
                return;
            }

            fetch('@Url.Action("CambiarClaveAdmin", "TI")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ adminId: parseInt(adminId), nuevaClave: nueva })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    toastr.success('Contraseña actualizada correctamente');
                    $('#modalCambiarClave').modal('hide');
                } else {
                    toastr.error(data.message || 'Error al cambiar contraseña');
                }
            })
            .catch(error => {
                toastr.error('Error de conexión');
                console.error('Error:', error);
            });
        });

        function eliminarAdministrador(adminId, nombre) {
            Swal.fire({
                title: 'Eliminar Administrador',
                text: "¿Está seguro que desea eliminar al administrador " + nombre + "? Esta acción no se puede deshacer.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('@Url.Action("EliminarAdmin", "TI")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ adminId: adminId })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire(
                                'Eliminado',
                                'Administrador eliminado correctamente',
                                'success'
                            ).then(() => {
                                location.reload();
                            });
                        } else {
                            toastr.error(data.message || 'Error al eliminar administrador');
                        }
                    })
                    .catch(error => {
                        toastr.error('Error de conexión');
                        console.error('Error:', error);
                    });
                }
            });
        }

        function regenerarTarjeta(adminId) {
            Swal.fire({
                title: '¿Regenerar tarjeta?',
                text: "Se invalidará la tarjeta anterior y deberá grabarla nuevamente",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, regenerar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('@Url.Action("RegenerarTarjeta", "TI")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ adminId: adminId })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire(
                                'Regenerada',
                                'Tarjeta regenerada. Nuevo UID: ' + data.uid,
                                'success'
                            ).then(() => {
                                location.reload();
                            });
                        } else {
                            toastr.error(data.message || 'Error al regenerar tarjeta');
                        }
                    })
                    .catch(error => {
                        toastr.error('Error de conexión');
                        console.error('Error:', error);
                    });
                }
            });
        }
    </script>
}

<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
</style>