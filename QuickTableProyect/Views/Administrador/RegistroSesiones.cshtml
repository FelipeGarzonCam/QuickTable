@model IEnumerable<QuickTableProyect.Dominio.JornadaDiariaDto>
@{
    ViewData["Title"] = "Registro de Jornadas Laborales";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Registro de Jornadas Laborales</h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-filter"></i> Filtros de Búsqueda</h3>
            </div>
            <div class="card-body">
                <form id="formFiltros" method="get" asp-action="RegistroSesiones">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Fecha</label>
                                <input type="date" class="form-control" name="fecha" id="fecha" 
                                       value="@ViewBag.Fecha?.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Empleado</label>
                                <select class="form-control" name="empleadoId" id="empleadoId">
                                    <option value="">Todos</option>
                                    @foreach (var emp in ViewBag.Empleados)
                                    {
                                        <option value="@emp.Id" selected="@(ViewBag.EmpleadoId == emp.Id)">
                                            @emp.Nombre
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Rol</label>
                                <select class="form-control" name="rol" id="rol">
                                    <option value="">Todos</option>
                                    @foreach (var rolItem in ViewBag.Roles)
                                    {
                                        <option value="@rolItem" selected="@(ViewBag.RolSeleccionado == rolItem)">
                                            @rolItem
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">                            
                            <a href="@Url.Action("RegistroSesiones")" class="btn btn-secondary">
                                <i class="fas fa-eraser"></i> Limpiar
                            </a>
                            <a href="@Url.Action("ExportarExcel", new { 
                                fecha = ViewBag.Fecha, 
                                empleadoId = ViewBag.EmpleadoId, 
                                rol = ViewBag.RolSeleccionado 
                            })" class="btn btn-success float-right">
                                <i class="fas fa-file-excel"></i> Exportar a Excel
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-calendar-day"></i> Jornadas Registradas</h3>
                <div class="card-tools">
                    <span class="badge badge-primary">Total: @(Model?.Count() ?? 0) jornadas</span>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-hover table-bordered" id="tablaJornadas">
                    <thead class="thead-light">
                        <tr>
                            <th>Empleado</th>
                            <th>Rol</th>
                            <th>Fecha</th>
                            <th>Primera Entrada</th>
                            <th>Última Salida</th>
                            <th>Tiempo Trabajado</th>
                            <th>Sesiones</th>
                            <th>Estado/Anotación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="fas fa-info-circle fa-2x mb-2"></i>
                                    <p>No hay registros para mostrar con los filtros seleccionados</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var jornada in Model)
                            {
                                <tr>
                                    <td><strong>@jornada.EmpleadoNombre</strong></td>
                                    <td>
                                        <span class="badge badge-@(jornada.Rol switch {
                                            "Admin" => "danger",
                                            "Mesero" => "info",
                                            "Cocina" => "warning",
                                            "Cajero" => "success",
                                            _ => "secondary"
                                        })">
                                            @jornada.Rol
                                        </span>
                                    </td>
                                    <td data-order="@jornada.Fecha.ToString("yyyy-MM-dd")">@jornada.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td data-order="@(jornada.PrimeraEntrada.HasValue ? jornada.Fecha.ToString("yyyy-MM-dd") + " " + jornada.PrimeraEntrada.Value.ToString("HH:mm") : "9999-99-99 99:99")">
                                        @if (jornada.PrimeraEntrada.HasValue)
                                        {
                                            <i class="fas fa-sign-in-alt text-success"></i>
                                            <span>@jornada.PrimeraEntrada.Value.ToString("hh:mm tt")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td data-order="@(jornada.UltimaSalida.HasValue ? jornada.Fecha.ToString("yyyy-MM-dd") + " " + jornada.UltimaSalida.Value.ToString("HH:mm") : "9999-99-99 99:99")">
                                        @if (jornada.UltimaSalida.HasValue)
                                        {
                                            <i class="fas fa-sign-out-alt text-danger"></i>
                                            <span>@jornada.UltimaSalida.Value.ToString("hh:mm tt")</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">Sin salida</span>
                                        }
                                    </td>
                                    <td data-order="@((int)jornada.TiempoTrabajado.TotalMinutes)">
                                        @if (jornada.TiempoTrabajado.TotalMinutes > 0)
                                        {
                                            <strong>@((int)jornada.TiempoTrabajado.TotalHours)h @jornada.TiempoTrabajado.Minutes m</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge badge-pill badge-info">@jornada.TotalSesiones</span>
                                    </td>
                                    <td>
                                        @if (jornada.Anotacion.Contains("completada con tarjeta"))
                                        {
                                            <span class="badge badge-success">
                                                <i class="fas fa-id-card"></i> @jornada.Anotacion
                                            </span>
                                        }
                                        else if (jornada.Anotacion.Contains("manualmente"))
                                        {
                                            <span class="badge badge-primary">
                                                <i class="fas fa-hand-paper"></i> @jornada.Anotacion
                                            </span>
                                        }
                                        else if (jornada.Anotacion.Contains("timeout"))
                                        {
                                            <span class="badge badge-danger">
                                                <i class="fas fa-clock"></i> @jornada.Anotacion
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">
                                                <i class="fas fa-exclamation-triangle"></i> @jornada.Anotacion
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <link rel="stylesheet" href="~/AdminLTE/plugins/datatables-bs4/css/dataTables.bootstrap4.css">
    <script src="~/AdminLTE/plugins/datatables/jquery.dataTables.js"></script>
    <script src="~/AdminLTE/plugins/datatables-bs4/js/dataTables.bootstrap4.js"></script>
    
    <script>
        $(document).ready(function() {
            var tieneRegistros = @((Model != null && Model.Any()) ? "true" : "false");
            
            if (tieneRegistros) {
                $('#tablaJornadas').DataTable({
                    "language": {
                        "emptyTable": "No hay registros disponibles",
                        "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                        "infoEmpty": "Mostrando 0 a 0 de 0 registros",
                        "infoFiltered": "(filtrado de _MAX_ registros totales)",
                        "lengthMenu": "Mostrar _MENU_ registros",
                        "loadingRecords": "Cargando...",
                        "processing": "Procesando...",
                        "search": "Buscar:",
                        "zeroRecords": "No se encontraron coincidencias",
                        "paginate": {
                            "first": "Primero",
                            "last": "Último",
                            "next": "Siguiente",
                            "previous": "Anterior"
                        }
                    },
                    "order": [[2, "desc"]],
                    "pageLength": 25,
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    "responsive": true,
                    "columnDefs": [
                        { "orderable": false, "targets": 7 }
                    ]
                });
            }

            // Filtros automáticos
            $('#fecha, #empleadoId, #rol').on('change', function() {
                $('#formFiltros').submit();
            });

            // Mejorar botón Limpiar
            $('a[href*="RegistroSesiones"]').on('click', function(e) {
                if ($(this).hasClass('btn-secondary')) {
                    e.preventDefault();
                    $('#fecha').val('');
                    $('#empleadoId').val('');
                    $('#rol').val('');
                    window.location.href = '@Url.Action("RegistroSesiones")';
                }
            });
        });
    </script>
}

