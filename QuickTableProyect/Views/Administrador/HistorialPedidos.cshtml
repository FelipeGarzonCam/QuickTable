
@{
    ViewData["Title"] = "Historial de Pedidos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .pedido-card {
        cursor: pointer;
        transition: all 0.3s ease;
        border-left: 4px solid #007bff;
    }

        .pedido-card:hover {
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }

    .tiempo-badge {
        font-size: 0.75rem;
        padding: 0.4rem 0.5rem;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: inline-block;
        max-width: 100%;
    }


    .badge-tiempo-excelente {
        background-color: #28a745;
        color: white;
    }

    .badge-tiempo-normal {
        background-color: #ffc107;
        color: #212529;
    }

    .badge-tiempo-aceptable {
        background-color: #fd7e14;
        color: white;
    }

    .badge-tiempo-lento {
        background-color: #dc3545;
        color: white;
    }

    .detalle-pedido {
        background-color: rgba(0, 0, 0, 0.03);
        border-radius: 5px;
        padding: 1rem;
    }

    .dark-mode .detalle-pedido {
        background-color: rgba(255, 255, 255, 0.05);
    }

    .tabla-items {
        font-size: 0.9rem;
    }

    .dark-mode .tabla-items {
        color: #c2c7d0;
    }

        .dark-mode .tabla-items thead th {
            color: #c2c7d0;
            border-color: rgba(255, 255, 255, 0.1);
        }

        .dark-mode .tabla-items tbody td {
            border-color: rgba(255, 255, 255, 0.1);
        }

        .dark-mode .tabla-items tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }

    .loading-spinner {
        text-align: center;
        padding: 2rem;
    }

    .dark-mode .loading-spinner {
        color: #c2c7d0;
    }

    .detalle-pedido .row {
        color: inherit;
    }

    .dark-mode .detalle-pedido .row {
        color: #c2c7d0;
    }

    .dark-mode .card-body.detalle-pedido {
        background-color: #343a40;
        color: #c2c7d0;
    }

    .dark-mode .border-top {
        border-color: rgba(255, 255, 255, 0.1) !important;
    }

    /* Vista tabla */
    #tablaContainer table { font-size: 0.88rem; }
    #tablaContainer .detalle-fila td { padding: 0; }
    #tablaContainer .detalle-fila .detalle-pedido { border-radius: 0; margin: 0; }
    .btn-vista { min-width: 36px; }
    .btn-vista.active { box-shadow: inset 0 2px 4px rgba(0,0,0,0.25); }
    #tablaContainer .fila-pedido { cursor: pointer; }
    #tablaContainer .fila-pedido:hover { filter: brightness(0.96); }
    .dark-mode #tablaContainer table { color: #c2c7d0; }
    .dark-mode #tablaContainer thead th { border-color: rgba(255,255,255,0.1); }
    .dark-mode #tablaContainer tbody td { border-color: rgba(255,255,255,0.08); }
    .dark-mode #tablaContainer tbody tr:hover { background: rgba(255,255,255,0.04); }
</style>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Historial de Pedidos</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Administrador/Index">Inicio</a></li>
                    <li class="breadcrumb-item active">Historial de Pedidos</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header d-flex align-items-center">
                <h3 class="card-title mb-0 mr-auto">
                    <i class="fas fa-history mr-2"></i>
                    Registro Completo de Pedidos
                </h3>
                <div class="btn-group ml-3" role="group" title="Cambiar vista">
                    <button id="btnVistaCards" class="btn btn-sm btn-primary btn-vista active" onclick="cambiarVista('cards')" title="Vista tarjetas">
                        <i class="fas fa-th-large"></i>
                    </button>
                    <button id="btnVistaTabla" class="btn btn-sm btn-outline-primary btn-vista" onclick="cambiarVista('tabla')" title="Vista tabla">
                        <i class="fas fa-table"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-3 align-items-end">
                    <div class="col-lg-2 col-md-3 col-sm-6 mb-2 mb-lg-0">
                        <label class="mb-1">Fecha</label>
                        <input type="date" id="filtroFecha" class="form-control form-control-sm">
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 mb-2 mb-lg-0">
                        <label class="mb-1">Método de Pago</label>
                        <select id="filtroMetodoPago" class="form-control form-control-sm">
                            <option value="">Todos</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Tarjeta">Tarjeta</option>
                            <option value="QR">QR</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 mb-2 mb-lg-0">
                        <label class="mb-1">Mesero</label>
                        <input type="text" id="filtroMesero" class="form-control form-control-sm" placeholder="Nombre del mesero">
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 mb-2 mb-lg-0">
                        <label class="mb-1">Mesa</label>
                        <input type="text" id="filtroMesa" class="form-control form-control-sm" placeholder="Núm. mesa">
                    </div>
                    <div class="col-lg-4 col-md-12 text-lg-right">                       
                        <button id="btnLimpiar" class="btn btn-secondary btn-sm">
                            <i class="fas fa-eraser"></i> Limpiar
                        </button>
                        <button id="btnExportar" class="btn btn-success btn-sm">
                            <i class="fas fa-file-excel"></i> Exportar a Excel
                        </button>
                    </div>
                </div>

                <!-- Vista tarjetas -->
                <div id="pedidosContainer" class="row"></div>

                <!-- Vista tabla -->
                <div id="tablaContainer" style="display:none; overflow-x:auto;">
                    <table class="table table-bordered table-hover table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>#</th>
                                <th>Mesa</th>
                                <th>Mesero</th>
                                <th>Fecha</th>
                                <th class="text-center">🔥 Cocina</th>
                                <th class="text-center">🏃 Entrega</th>
                                <th class="text-center">⏱ Total</th>
                                <th>Pago</th>
                                <th class="text-right">Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="tablaBody"></tbody>
                    </table>
                </div>

                <div class="row mt-3">
                    <div class="col-md-12">
                        <nav>
                            <ul class="pagination justify-content-center" id="paginacion">
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>




@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;
        let currentView = 'cards';

        function cambiarVista(vista) {
            currentView = vista;
            if (vista === 'cards') {
                $('#pedidosContainer').show();
                $('#tablaContainer').hide();
                $('#btnVistaCards').removeClass('btn-outline-primary').addClass('btn-primary active');
                $('#btnVistaTabla').removeClass('btn-primary active').addClass('btn-outline-primary');
            } else {
                $('#pedidosContainer').hide();
                $('#tablaContainer').show();
                $('#btnVistaTabla').removeClass('btn-outline-primary').addClass('btn-primary active');
                $('#btnVistaCards').removeClass('btn-primary active').addClass('btn-outline-primary');
            }
            cargarPedidos(currentPage);
        }

        $(document).ready(function () {
            cargarPedidos();

            $('#filtroFecha, #filtroMetodoPago, #filtroMesero, #filtroMesa').on('change keyup', function () {
                currentPage = 1;
                cargarPedidos();
            });

            $('#btnLimpiar').click(function () {
                $('#filtroFecha').val('');
                $('#filtroMetodoPago').val('');
                $('#filtroMesero').val('');
                $('#filtroMesa').val('');
                currentPage = 1;
                cargarPedidos();
            });

            $('#btnExportar').click(function () {
                exportarExcel();
            });
        });

        function cargarPedidos(pageNumber = 1) {
            const fecha = $('#filtroFecha').val();
            const metodoPago = $('#filtroMetodoPago').val();
            const mesero = $('#filtroMesero').val();
            const mesa = $('#filtroMesa').val();

            $.ajax({
                url: '/Administrador/ObtenerHistorialPedidos',
                type: 'GET',
                data: {
                    fecha: fecha,
                    metodoPago: metodoPago,
                    nombreMesero: mesero,
                    mesa: mesa,
                    pageNumber: pageNumber,
                    pageSize: 10
                },
                success: function (response) {
                    renderPedidos(response.pedidos);
                    currentPage = response.currentPage;
                    totalPages = response.totalPages;
                    renderPaginacion();
                },
                error: function () {
                    toastr.error('Error al cargar los pedidos');
                }
            });
        }

        function renderPedidos(pedidos) {
            if (currentView === 'tabla') {
                renderTabla(pedidos);
            } else {
                renderCards(pedidos);
            }
        }

        function renderCards(pedidos) {
            const container = $('#pedidosContainer');
            container.empty();
            if (pedidos.length === 0) {
                container.html('<div class="col-12"><div class="alert alert-info">No se encontraron pedidos con los filtros aplicados.</div></div>');
                return;
            }
            pedidos.forEach(pedido => container.append(crearCardPedido(pedido)));
        }

        function renderTabla(pedidos) {
            const tbody = $('#tablaBody');
            tbody.empty();
            if (pedidos.length === 0) {
                tbody.html('<tr><td colspan="10"><div class="alert alert-info mb-0">No se encontraron pedidos con los filtros aplicados.</div></td></tr>');
                return;
            }
            pedidos.forEach(pedido => {
                const fecha = new Date(pedido.fechaCreacion).toLocaleString('es-CO', {
                    year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
                });
                const total = pedido.total.toLocaleString('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 });
                tbody.append(`
                    <tr class="fila-pedido" onclick="toggleDetalleTabla(${pedido.pedidoId}, this)">
                        <td><strong>#${pedido.pedidoId}</strong></td>
                        <td>Mesa ${pedido.mesa}</td>
                        <td>${pedido.nombreMesero}</td>
                        <td style="white-space:nowrap;">${fecha}</td>
                        <td class="text-center">
                            <span class="badge tiempo-badge ${getClaseTiempoCocina(pedido.tiempoCocinaAListo)}">${formatearTiempo(pedido.tiempoCocinaAListo)}</span>
                        </td>
                        <td class="text-center">
                            <span class="badge tiempo-badge ${getClaseTiempoEntrega(pedido.tiempoListoAAceptado)}">${formatearTiempo(pedido.tiempoListoAAceptado)}</span>
                        </td>
                        <td class="text-center">
                            <span class="badge tiempo-badge ${getClaseTiempoTotal(pedido.tiempoTotal)}">${formatearTiempo(pedido.tiempoTotal)}</span>
                        </td>
                        <td><span class="badge badge-info">${pedido.medioPago}</span></td>
                        <td class="text-right text-success font-weight-bold">${total}</td>
                        <td class="text-center"><i class="fas fa-chevron-down text-muted" id="ico-${pedido.pedidoId}"></i></td>
                    </tr>
                    <tr class="detalle-fila" id="detalle-tabla-${pedido.pedidoId}" style="display:none;">
                        <td colspan="10">
                            <div class="card-body detalle-pedido">
                                <div class="loading-spinner">
                                    <i class="fas fa-spinner fa-spin fa-2x"></i>
                                    <p>Cargando detalles...</p>
                                </div>
                            </div>
                        </td>
                    </tr>
                `);
            });
        }

        function toggleDetalleTabla(pedidoId, fila) {
            const detalleRow = $(`#detalle-tabla-${pedidoId}`);
            const ico = $(`#ico-${pedidoId}`);
            if (detalleRow.is(':visible')) {
                detalleRow.hide();
                ico.removeClass('fa-chevron-up').addClass('fa-chevron-down');
            } else {
                if (detalleRow.find('.loading-spinner').length > 0) {
                    $.ajax({
                        url: '/Administrador/ObtenerDetallePedido',
                        type: 'GET',
                        data: { pedidoId: pedidoId },
                        success: function(response) {
                            renderDetallePedidoTabla(pedidoId, response);
                        },
                        error: function() {
                            detalleRow.find('td').html('<div class="alert alert-danger mb-0">Error al cargar los detalles</div>');
                        }
                    });
                }
                detalleRow.show();
                ico.removeClass('fa-chevron-down').addClass('fa-chevron-up');
            }
        }

        function renderDetallePedidoTabla(pedidoId, datos) {
            const container = $(`#detalle-tabla-${pedidoId} td`);
            let html = '<div class="card-body detalle-pedido"><table class="table table-sm tabla-items table-striped mb-2">';
            html += '<thead><tr><th>Plato</th><th class="text-center">Cant.</th><th class="text-right">P. Unit.</th><th class="text-right">Subtotal</th></tr></thead><tbody>';
            datos.items.forEach(item => {
                html += `<tr>
                    <td>${item.nombreItem}</td>
                    <td class="text-center">${item.cantidad}</td>
                    <td class="text-right">${item.precioUnitario.toLocaleString('es-CO',{style:'currency',currency:'COP',minimumFractionDigits:0})}</td>
                    <td class="text-right"><strong>${item.subtotal.toLocaleString('es-CO',{style:'currency',currency:'COP',minimumFractionDigits:0})}</strong></td>
                </tr>`;
            });
            html += '</tbody></table>';
            const fmt = v => v.toLocaleString('es-CO',{style:'currency',currency:'COP',minimumFractionDigits:0});
            html += `<div class="row justify-content-end" style="font-size:0.9rem;">
                <div class="col-auto text-right">
                    <div>Subtotal: <strong>${fmt(datos.subtotal)}</strong></div>
                    <div>IVA: <strong>${fmt(datos.iva)}</strong></div>
                    <div>Propina: <strong>${fmt(datos.propina)}</strong></div>
                    <div class="mt-1 pt-1 border-top"><h6 class="mb-0 text-success">TOTAL: <strong>${fmt(datos.total)}</strong></h6></div>
                </div>
            </div></div>`;
            container.html(html);
        }

        function crearCardPedido(pedido) {
            const fechaFormateada = new Date(pedido.fechaCreacion).toLocaleString('es-CO', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit'
            });

            const totalFormateado = pedido.total.toLocaleString('es-CO', {
                style: 'currency',
                currency: 'COP',
                minimumFractionDigits: 0
            });

            return `
                <div class="col-md-6 col-lg-3 mb-3">
                    <div class="card pedido-card" onclick="toggleDetalle(${pedido.pedidoId})">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-receipt mr-2"></i>
                                Pedido #${pedido.pedidoId}
                                <span class="float-right">Mesa ${pedido.mesa}</span>
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <strong><i class="fas fa-user mr-1"></i> Mesero:</strong> ${pedido.nombreMesero}
                            </div>
                            <div class="mb-2">
                                <strong><i class="fas fa-clock mr-1"></i> Fecha:</strong> ${fechaFormateada}
                            </div>
                            <div class="mb-3">
                                <strong><i class="fas fa-credit-card mr-1"></i> Pago:</strong>
                                <span class="badge badge-info">${pedido.medioPago}</span>
                            </div>

                            <div class="row text-center mb-2 mx-0">
                                <div class="col-4 px-1">
                                    <small class="d-block text-muted">
                                        <i class="fas fa-fire"></i> Cocina
                                    </small>
                                    <span class="badge tiempo-badge ${getClaseTiempoCocina(pedido.tiempoCocinaAListo)}">
                                        ${formatearTiempo(pedido.tiempoCocinaAListo)}
                                    </span>
                                </div>
                                <div class="col-4 px-1">
                                    <small class="d-block text-muted">
                                        <i class="fas fa-running"></i> Entrega
                                    </small>
                                    <span class="badge tiempo-badge ${getClaseTiempoEntrega(pedido.tiempoListoAAceptado)}">
                                        ${formatearTiempo(pedido.tiempoListoAAceptado)}
                                    </span>
                                </div>
                                <div class="col-4 px-1">
                                    <small class="d-block text-muted">
                                        <i class="fas fa-stopwatch"></i> Total
                                    </small>
                                    <span class="badge tiempo-badge ${getClaseTiempoTotal(pedido.tiempoTotal)}">
                                        ${formatearTiempo(pedido.tiempoTotal)}
                                    </span>
                                </div>
                            </div>

                            <div class="text-center mt-3 pt-3 border-top">
                                <h4 class="mb-0 text-success">
                                    <strong>${totalFormateado}</strong>
                                </h4>
                            </div>
                        </div>
                        <div class="card-footer text-center bg-light">
                            <small class="text-muted">
                                <i class="fas fa-chevron-down"></i> Click para ver detalles
                            </small>
                        </div>
                        <div id="detalle-${pedido.pedidoId}" class="collapse">
                            <div class="card-body detalle-pedido">
                                <div class="loading-spinner">
                                    <i class="fas fa-spinner fa-spin fa-2x"></i>
                                    <p>Cargando detalles...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function formatearTiempo(timeSpanString) {
            if (!timeSpanString || timeSpanString === "00:00:00") {
                return "0:00 min";
            }

            const parts = timeSpanString.split(':');
            const hours = parseInt(parts[0]);
            const minutes = parseInt(parts[1]);
            const seconds = parseInt(parts[2]);

            const totalMinutes = (hours * 60) + minutes;

            return `${totalMinutes}:${seconds.toString().padStart(2, '0')} min`;
        }

        function getClaseTiempoCocina(tiempo) {
            const minutos = getMinutosTotales(tiempo);
            if (minutos < 10) return 'badge-tiempo-excelente';
            if (minutos < 20) return 'badge-tiempo-normal';
            if (minutos < 30) return 'badge-tiempo-aceptable';
            return 'badge-tiempo-lento';
        }

        function getClaseTiempoEntrega(tiempo) {
            const minutos = getMinutosTotales(tiempo);
            if (minutos < 2) return 'badge-tiempo-excelente';
            if (minutos < 5) return 'badge-tiempo-normal';
            if (minutos < 10) return 'badge-tiempo-aceptable';
            return 'badge-tiempo-lento';
        }

        function getClaseTiempoTotal(tiempo) {
            const minutos = getMinutosTotales(tiempo);
            if (minutos < 15) return 'badge-tiempo-excelente';
            if (minutos < 25) return 'badge-tiempo-normal';
            if (minutos < 35) return 'badge-tiempo-aceptable';
            return 'badge-tiempo-lento';
        }

        function getMinutosTotales(timeSpanString) {
            if (!timeSpanString) return 0;
            const parts = timeSpanString.split(':');
            const hours = parseInt(parts[0]) || 0;
            const minutes = parseInt(parts[1]) || 0;
            return (hours * 60) + minutes;
        }

        function toggleDetalle(pedidoId) {
            const detalleDiv = $(`#detalle-${pedidoId}`);

            if (detalleDiv.hasClass('show')) {
                detalleDiv.collapse('hide');
            } else {
                if (detalleDiv.find('.loading-spinner').length > 0) {
                    cargarDetallePedido(pedidoId);
                }
                detalleDiv.collapse('show');
            }
        }

        function cargarDetallePedido(pedidoId) {
            $.ajax({
                url: '/Administrador/ObtenerDetallePedido',
                type: 'GET',
                data: { pedidoId: pedidoId },
                success: function (response) {
                    renderDetallePedido(pedidoId, response);
                },
                error: function () {
                    $(`#detalle-${pedidoId}`).html('<div class="alert alert-danger">Error al cargar los detalles</div>');
                }
            });
        }

        function renderDetallePedido(pedidoId, datos) {
            const detalleDiv = $(`#detalle-${pedidoId}`);

            let itemsHtml = '<table class="table table-sm tabla-items table-striped">';
            itemsHtml += '<thead><tr><th>Plato</th><th class="text-center">Cant.</th><th class="text-right">P. Unit.</th><th class="text-right">Subtotal</th></tr></thead>';
            itemsHtml += '<tbody>';

            datos.items.forEach(item => {
                const precioUnitario = item.precioUnitario.toLocaleString('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 });
                const subtotal = item.subtotal.toLocaleString('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 });

                itemsHtml += `
                    <tr>
                        <td>${item.nombreItem}</td>
                        <td class="text-center">${item.cantidad}</td>
                        <td class="text-right">${precioUnitario}</td>
                        <td class="text-right"><strong>${subtotal}</strong></td>
                    </tr>
                `;
            });

            itemsHtml += '</tbody></table>';

            const subtotal = datos.subtotal.toLocaleString('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 });
            const iva = datos.iva.toLocaleString('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 });
            const propina = datos.propina.toLocaleString('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 });
            const total = datos.total.toLocaleString('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 });

            const resumenHtml = `
                <div class="mt-3 pt-3 border-top">
                    <div class="row">
                        <div class="col-6 text-right"><strong>Subtotal:</strong></div>
                        <div class="col-6 text-right">${subtotal}</div>
                    </div>
                    <div class="row">
                        <div class="col-6 text-right"><strong>IVA:</strong></div>
                        <div class="col-6 text-right">${iva}</div>
                    </div>
                    <div class="row">
                        <div class="col-6 text-right"><strong>Propina:</strong></div>
                        <div class="col-6 text-right">${propina}</div>
                    </div>
                    <div class="row mt-2 pt-2 border-top">
                        <div class="col-6 text-right"><h5><strong>TOTAL:</strong></h5></div>
                        <div class="col-6 text-right"><h5 class="text-success"><strong>${total}</strong></h5></div>
                    </div>
                </div>
            `;

            detalleDiv.html(`<div class="card-body detalle-pedido">${itemsHtml}${resumenHtml}</div>`);
        }

        function renderPaginacion() {
            const paginacion = $('#paginacion');
            paginacion.empty();

            if (totalPages <= 1) return;

            paginacion.append(`
                <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="cambiarPagina(${currentPage - 1}); return false;">Anterior</a>
                </li>
            `);

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                    paginacion.append(`
                        <li class="page-item ${i === currentPage ? 'active' : ''}">
                            <a class="page-link" href="#" onclick="cambiarPagina(${i}); return false;">${i}</a>
                        </li>
                    `);
                } else if (i === currentPage - 3 || i === currentPage + 3) {
                    paginacion.append('<li class="page-item disabled"><a class="page-link" href="#">...</a></li>');
                }
            }

            paginacion.append(`
                <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="cambiarPagina(${currentPage + 1}); return false;">Siguiente</a>
                </li>
            `);
        }

        function cambiarPagina(pageNumber) {
            if (pageNumber < 1 || pageNumber > totalPages) return;
            cargarPedidos(pageNumber);
        }

        function exportarExcel() {
            const fecha = $('#filtroFecha').val();
            const metodoPago = $('#filtroMetodoPago').val();
            const mesero = $('#filtroMesero').val();
            const mesa = $('#filtroMesa').val();

            const params = new URLSearchParams({
                fecha: fecha || '',
                metodoPago: metodoPago || '',
                nombreMesero: mesero || '',
                mesa: mesa || ''
            });

            window.location.href = `/Administrador/DescargarHistorialPedidosExcel?${params.toString()}`;
        }
    </script>
}

