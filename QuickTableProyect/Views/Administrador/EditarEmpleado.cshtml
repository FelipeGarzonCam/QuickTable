@model QuickTableProyect.Dominio.Empleado
@{
    ViewData["Title"] = "Editar Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card card-warning">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-user-edit mr-2"></i>
                        Editar Empleado
                    </h3>
                </div>

                <form asp-action="EditarEmpleado" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="TarjetaUID" />

                    <div class="card-body">
                        <!-- Nombre -->
                        <div class="form-group">
                            <label for="Nombre" class="form-label">
                                <i class="fas fa-user mr-1"></i>
                                Nombre Completo
                            </label>
                            <input type="text" asp-for="Nombre" class="form-control form-control-lg"
                                   placeholder="Ingrese el nombre completo" required>
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <!-- Rol -->
                        <div class="form-group">
                            <label for="Rol" class="form-label">
                                <i class="fas fa-user-tag mr-1"></i>
                                Rol
                            </label>
                            <select asp-for="Rol" class="form-control form-control-lg" required>
                                <option value="">Seleccione un rol</option>
                                <option value="Mesero">Mesero</option>
                                <option value="Cocina">Cocina</option>
                                <option value="Cajero">Cajero</option>
                            </select>
                            <span asp-validation-for="Rol" class="text-danger"></span>
                        </div>

                        <!-- Contraseña (readonly con botón para editar) -->
                        <div class="form-group">
                            <label for="Contrasena" class="form-label">
                                <i class="fas fa-lock mr-1"></i>
                                Contraseña
                            </label>
                            <div class="input-group">
                                <input type="password" asp-for="Contrasena" id="Contrasena"
                                       class="form-control form-control-lg"
                                       readonly>
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-info" onclick="showPasswordModal()">
                                        <i class="fas fa-edit"></i> Cambiar Contraseña
                                    </button>
                                </div>
                            </div>
                            <small class="form-text text-muted">
                                Deje vacío si no desea cambiar la contraseña
                            </small>
                        </div>
                    </div>

                    <div class="card-footer">
                        <div class="row">
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-warning btn-lg btn-block">
                                    <i class="fas fa-save mr-2"></i>
                                    Guardar Cambios
                                </button>
                            </div>
                            <div class="col-md-6">
                                <a asp-action="ModificarEmpleados" class="btn btn-secondary btn-lg btn-block">
                                    <i class="fas fa-times mr-2"></i>
                                    Cancelar
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal para confirmar y cambiar contraseña -->
<div class="modal fade" id="passwordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">
                    <i class="fas fa-key mr-2"></i>
                    Cambiar Contraseña
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Confirmar contraseña actual -->
                <div class="form-group">
                    <label for="currentPassword">
                        <i class="fas fa-lock mr-1"></i>
                        Contraseña Actual
                    </label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="currentPassword"
                               placeholder="Ingrese su contraseña actual">
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary"
                                    onclick="togglePasswordModal('currentPassword', this)">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Nueva contraseña -->
                <div class="form-group" id="newPasswordGroup" style="display: none;">
                    <label for="newPassword">
                        <i class="fas fa-key mr-1"></i>
                        Nueva Contraseña
                    </label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="newPassword"
                               placeholder="Ingrese la nueva contraseña">
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary"
                                    onclick="togglePasswordModal('newPassword', this)">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Confirmar nueva contraseña -->
                <div class="form-group" id="confirmPasswordGroup" style="display: none;">
                    <label for="confirmNewPassword">
                        <i class="fas fa-check mr-1"></i>
                        Confirmar Nueva Contraseña
                    </label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="confirmNewPassword"
                               placeholder="Confirme la nueva contraseña">
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary"
                                    onclick="togglePasswordModal('confirmNewPassword', this)">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <small id="passwordMatchError" class="text-danger" style="display: none;">
                        Las contraseñas no coinciden
                    </small>
                </div>

                <div id="errorAlert" class="alert alert-danger mt-3" style="display: none;">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    Contraseña actual incorrecta
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    <i class="fas fa-times mr-2"></i>
                    Cancelar
                </button>
                <button type="button" class="btn btn-warning" id="confirmBtn" onclick="confirmPassword()">
                    <i class="fas fa-check mr-2"></i>
                    Confirmar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let passwordVerified = false;

        function showPasswordModal() {
            $('#passwordModal').modal('show');
            document.getElementById('currentPassword').value = '';
            document.getElementById('newPassword').value = '';
            document.getElementById('confirmNewPassword').value = '';
            document.getElementById('errorAlert').style.display = 'none';
            document.getElementById('newPasswordGroup').style.display = 'none';
            document.getElementById('confirmPasswordGroup').style.display = 'none';
            document.getElementById('passwordMatchError').style.display = 'none';
            passwordVerified = false;
            document.getElementById("confirmBtn").innerHTML = '<i class="fas fa-check mr-2"></i> Confirmar';
        }

        function togglePasswordModal(fieldId, button) {
            const field = document.getElementById(fieldId);
            const icon = button.querySelector('i');

            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        function confirmPassword() {
            if (!passwordVerified) {
                const enteredPassword = document.getElementById("currentPassword").value;
                const actualPassword = '@Model.Contrasena';

                if (!enteredPassword) {
                    document.getElementById("errorAlert").innerHTML = '<i class="fas fa-exclamation-triangle mr-2"></i>Ingrese su contraseña actual';
                    document.getElementById("errorAlert").style.display = "block";
                    return;
                }

                if (enteredPassword === actualPassword) {
                    document.getElementById("errorAlert").style.display = "none";
                    document.getElementById("newPasswordGroup").style.display = "block";
                    document.getElementById("confirmPasswordGroup").style.display = "block";
                    document.getElementById("confirmBtn").innerHTML = '<i class="fas fa-save mr-2"></i> Guardar Nueva Contraseña';
                    passwordVerified = true;
                } else {
                    document.getElementById("errorAlert").innerHTML = '<i class="fas fa-exclamation-triangle mr-2"></i>Contraseña actual incorrecta';
                    document.getElementById("errorAlert").style.display = "block";
                    document.getElementById("currentPassword").value = '';
                }
            } else {
                const newPassword = document.getElementById("newPassword").value;
                const confirmPassword = document.getElementById("confirmNewPassword").value;

                if (!newPassword || !confirmPassword) {
                    alert('Complete todos los campos de contraseña');
                    return;
                }

                if (newPassword !== confirmPassword) {
                    document.getElementById("passwordMatchError").style.display = "block";
                    return;
                }

                if (newPassword.length < 4) {
                    alert('La contraseña debe tener al menos 4 caracteres');
                    return;
                }

                document.getElementById("Contrasena").value = newPassword;
                document.getElementById("Contrasena").readOnly = false;
                $('#passwordModal').modal('hide');

                if (typeof toastr !== 'undefined') {
                    toastr.success('Contraseña actualizada. No olvide guardar los cambios.');
                } else {
                    alert('Contraseña actualizada. No olvide guardar los cambios.');
                }
            }
        }

        $(document).ready(function() {
            $('#confirmNewPassword').on('input', function() {
                const newPassword = $('#newPassword').val();
                const confirmPassword = $(this).val();
                const errorDiv = $('#passwordMatchError');

                if (newPassword !== confirmPassword && confirmPassword !== '') {
                    errorDiv.show();
                } else {
                    errorDiv.hide();
                }
            });
        });
    </script>
}

