@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuickTableProyect</title>
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/img/icono.png">

    <link href="~/AdminLTE/dist/css/adminlte.min.css" rel="stylesheet" />

    <link href="~/AdminLTE/dist/css/adminlte.min.css" rel="stylesheet" />
    <link href="~/AdminLTE/plugins/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="~/AdminLTE/plugins/toastr/toastr.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <meta name="user-role" content="@HttpContextAccessor.HttpContext.Session.GetString("Rol")" />
    <meta name="login-url" content="@Url.Action("Login", "Login")" />

    @RenderSection("Styles", required: false)

    <style>
        /* Ajuste para cuando no hay sidebar */
        body:not(.sidebar-mini-md):not(.sidebar-mini-xs):not(.layout-top-nav) .content-wrapper.no-sidebar,
        body:not(.sidebar-mini-md):not(.sidebar-mini-xs):not(.layout-top-nav) .main-footer.no-sidebar,
        body:not(.sidebar-mini-md):not(.sidebar-mini-xs):not(.layout-top-nav) .main-header.no-sidebar {
            margin-left: 0 !important;
        }

        /* Estilos del switch del modo oscuro */
        .theme-switch-wrapper {
            display: flex;
            align-items: center;
            margin: 0 15px;
        }

        .theme-switch {
            display: inline-block;
            height: 34px;
            position: relative;
            width: 70px;
            cursor: pointer;
            margin: 0;
        }

            .theme-switch input {
                display: none;
            }

        .slider {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            bottom: 0;
            cursor: pointer;
            left: 0;
            position: absolute;
            right: 0;
            top: 0;
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            border-radius: 34px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

            .slider:before {
                background-color: #fff;
                bottom: 4px;
                content: "";
                height: 26px;
                left: 4px;
                position: absolute;
                transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
                width: 26px;
                border-radius: 50%;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            }

        input:checked + .slider {
            background: linear-gradient(135deg, #ffa500 0%, #ff6347 100%);
        }

            input:checked + .slider:before {
                transform: translateX(36px);
            }

        .sun-icon,
        .moon-icon {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            font-size: 16px;
            transition: all 0.4s ease;
            pointer-events: none;
        }

        .sun-icon {
            left: 8px;
            color: #fff;
            opacity: 0;
        }

        .moon-icon {
            right: 8px;
            color: #fff;
            opacity: 1;
        }

        input:checked + .slider .sun-icon {
            opacity: 1;
        }

        input:checked + .slider .moon-icon {
            opacity: 0;
        }

        .slider:hover {
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
            transform: scale(1.05);
        }

        .theme-switch-wrapper:hover .slider {
            animation: pulse 0.8s ease-in-out;
        }

        @@keyframes pulse {
            0% {
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            }

            50% {
                box-shadow: 0 6px 25px rgba(0, 0, 0, 0.5);
            }

            100% {
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            }
        }
    </style>
</head>

<body class="hold-transition sidebar-mini layout-fixed dark-mode sidebar-collapse">
    <div class="wrapper">

        <!-- Navbar (barra superior) -->
        @if (HttpContextAccessor.HttpContext.Session.GetString("Rol") != null)
        {
            var userRole = HttpContextAccessor.HttpContext.Session.GetString("Rol");
            var hasSidebar = (userRole == "Admin" || userRole == "TI");

            <nav class="main-header navbar navbar-expand navbar-white navbar-light dark-mode @(hasSidebar ? "" : "no-sidebar")">
                @if (hasSidebar)
                {
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                        </li>
                    </ul>
                }

                <ul class="navbar-nav ml-auto">
                    <!-- Botón de Tema Oscuro/Claro con Switch -->
                    <li class="nav-item d-flex align-items-center">
                        <div class="theme-switch-wrapper">
                            <label class="theme-switch" for="checkbox">
                                <input type="checkbox" id="checkbox" class="toggle-theme-checkbox">
                                <div class="slider">
                                    <i class="fas fa-sun sun-icon"></i>
                                    <i class="fas fa-moon moon-icon"></i>
                                </div>
                            </label>
                        </div>
                    </li>

                    <!-- Botón Regresar -->
                    <li class="nav-item">
                        <a href="#" class="nav-link" style="color: #FFF" onclick="handleBackButton()">
                            <i class="fas fa-arrow-left"></i> Regresar
                        </a>
                    </li>

                    <!-- Botón de Cerrar Sesión -->
                    <li class="nav-item">
                        <a asp-action="Logout" asp-controller="Login" class="nav-link" style="color: #FFF">
                            <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                        </a>
                    </li>
                </ul>
            </nav>
        }

        <!-- Main Sidebar Container -->
        @{
            var rol = HttpContextAccessor.HttpContext.Session.GetString("Rol");
        }

        @if (rol == "Admin" || rol == "TI")
        {
            <aside class="main-sidebar sidebar-dark-primary elevation-4">
                <a href="@Url.Action("Index", rol == "Admin" ? "Administrador" : "TI")" class="brand-link">
                    <img id="sidebar-logo" src="~/img/LogoLight.png" alt="Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
                    <span class="brand-text font-weight-light">QuickTable</span>
                </a>


                <div class="sidebar mt-2">
                    <nav>
                        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                            @if (rol == "Admin")
                            {
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Administrador")" class="nav-link">
                                        <i class="nav-icon fas fa-user-cog"></i>
                                        <p>Panel Administrador</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("ModificarMenu", "Administrador")" class="nav-link">
                                        <i class="nav-icon fas fa-utensils"></i>
                                        <p>Modificar Menú</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("ModificarEmpleados", "Administrador")" class="nav-link">
                                        <i class="nav-icon fas fa-users"></i>
                                        <p>Modificar empleados</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("RegistroSesiones", "Administrador")" class="nav-link">
                                        <i class="nav-icon fas fa-calendar-check"></i>
                                        <p>Registro de Sesiones</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("HistorialPedidos", "Administrador")" class="nav-link">
                                        <i class="nav-icon fas fa-history"></i>
                                        <p>Historial De Pedidos</p>
                                    </a>
                                </li>
                            }
                            else if (rol == "TI")
                            {
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "TI")" class="nav-link">
                                        <i class="nav-icon fas fa-tools"></i>
                                        <p>Panel de TI</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("GestionTarjetas", "TI")" class="nav-link">
                                        <i class="nav-icon fas fa-id-card"></i>
                                        <p>Gestión de Tarjetas</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("GestionBackups", "TI")" class="nav-link">
                                        <i class="nav-icon fas fa-database"></i>
                                        <p>Gestión de Backups</p>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </aside>
        }

        <!-- Contenedor principal de la página -->
        <div class="content-wrapper @((rol == "Admin" || rol == "TI") ? "" : "no-sidebar")">
            <!-- Contenido principal -->
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <footer class="main-footer @((rol == "Admin" || rol == "TI") ? "" : "no-sidebar")">
            <div class="float-right d-none d-sm-block">
                <b>By</b> Felipe Garzon
            </div>
            <strong>Copyright &copy; 2025 <a href="#">QuickTable</a>.</strong> Todos los derechos reservados.
        </footer>

        <aside class="control-sidebar control-sidebar-dark"></aside>

    </div>

    <!-- Scripts -->
    <script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
    <script src="~/AdminLTE/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/AdminLTE/plugins/toastr/toastr.min.js"></script>
    <script src="~/AdminLTE/dist/js/adminlte.min.js"></script>
    <script src="~/AdminLTE/plugins/sweetalert2/sweetalert2.min.js"></script>

    @RenderSection("Scripts", required: false)

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const themeToggle = document.querySelector('.toggle-theme-checkbox');
            const body = document.querySelector('body');
            const sidebarLogo = document.getElementById('sidebar-logo');

            // Cargar tema guardado
            const savedTheme = localStorage.getItem('theme') || 'dark';
            if (savedTheme === 'light') {
                body.classList.remove('dark-mode');
            }

            // Actualizar switch inicial y logo
            updateThemeButton(savedTheme);
            updateLogo(savedTheme);

            // Evento change del checkbox
            themeToggle.addEventListener('change', function (e) {
                let currentTheme;
                if (body.classList.contains('dark-mode')) {
                    body.classList.remove('dark-mode');
                    localStorage.setItem('theme', 'light');
                    currentTheme = 'light';
                } else {
                    body.classList.add('dark-mode');
                    localStorage.setItem('theme', 'dark');
                    currentTheme = 'dark';
                }

                updateThemeButton(currentTheme);
                updateLogo(currentTheme);
            });

            function updateThemeButton(theme) {
                if (theme === 'dark') {
                    themeToggle.checked = false;
                } else {
                    themeToggle.checked = true;
                }
            }

            function updateLogo(theme) {
                if (sidebarLogo) {
                    if (theme === 'dark') {
                        // En modo oscuro, usar logo claro
                        sidebarLogo.src = '@Url.Content("~/img/LogoLight.png")';
                    } else {
                        // En modo claro, usar logo oscuro
                        sidebarLogo.src = '@Url.Content("~/img/LogoDark.png")';
                    }
                }
            }
        });

        // Función para redirección segura
        function redirectToDashboard(role) {
            let redirectUrl = '/';
            switch (role) {
                case 'Admin':
                    redirectUrl = '@Url.Action("Index", "Administrador")';
                    break;
                case 'TI':
                    redirectUrl = '@Url.Action("Index", "TI")';
                    break;
                case 'Mesero':
                    redirectUrl = '@Url.Action("Index", "Mesero")';
                    break;
                case 'Cocina':
                    redirectUrl = '@Url.Action("Index", "Cocina")';
                    break;
                case 'Caja':
                    redirectUrl = '@Url.Action("Index", "Caja")';
                    break;
                default:
                    redirectUrl = '/';
            }
            window.location.href = redirectUrl;
        }

        // Lógica mejorada para el botón regresar
        function handleBackButton() {
            const userRole = document.querySelector('meta[name="user-role"]').content;
            const loginUrl = document.querySelector('meta[name="login-url"]').content;
            const currentOrigin = window.location.origin;
            const referrer = document.referrer;

            // 1. Si no hay página anterior o es de otro dominio
            if (!referrer || !referrer.startsWith(currentOrigin)) {
                redirectToDashboard(userRole);
                return;
            }

            // 2. Si viene del login
            if (referrer.includes(loginUrl)) {
                redirectToDashboard(userRole);
                return;
            }

            // 3. Si es la única página en el historial
            if (window.history.length <= 1) {
                redirectToDashboard(userRole);
                return;
            }

            // 4. Verificar si la página anterior es válida
            const allowedPaths = [
                '@Url.Action("Index", "Administrador")',
                '@Url.Action("ModificarMenu", "Administrador")',
                '@Url.Action("ModificarEmpleados", "Administrador")',
                '@Url.Action("RegistroSesiones", "Administrador")',
                '@Url.Action("HistorialPedidos", "Administrador")',
                '@Url.Action("Index", "TI")',
                '@Url.Action("GestionTarjetas", "TI")',
                '@Url.Action("GestionBackups", "TI")',
                '@Url.Action("Index", "Mesero")',
                '@Url.Action("Index", "Cocina")',
                '@Url.Action("Index", "Caja")'
            ];

            const previousPage = document.referrer.replace(currentOrigin, '');
            if (!allowedPaths.some(path => previousPage.includes(path))) {
                redirectToDashboard(userRole);
                return;
            }

            // Navegación normal
            window.history.back();
        }

        // Bloquear navegación externa con el botón de retroceso del navegador
        window.onpopstate = function (event) {
            const currentOrigin = window.location.origin;
            if (!document.referrer || !document.referrer.startsWith(currentOrigin)) {
                const userRole = document.querySelector('meta[name="user-role"]').content;
                redirectToDashboard(userRole);
            }
        };
    </script>


</body>
</html>
