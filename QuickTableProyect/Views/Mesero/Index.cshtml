@{
    ViewBag.Title = "Pedidos Activos";
}
<!--puta vida -->
<link rel="stylesheet" href="~/AdminLTE/plugins/sweetalert2/sweetalert2.min.css">
<style>
    /* Animaciones y efectos hover */
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        }

    /* Info box personalizado */
    .info-box-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    /* Tabla responsive dentro de las cards */
    .table-responsive {
        overflow-x: auto;
    }

    /* Botón de nuevo pedido destacado */
    .btn-block {
        font-size: 1.1rem;
        padding: 12px;
    }

    .content-wrapper {
        margin-left: 1% !important;
        margin-right: 1% !important;
    }

    /* Estilos para móvil */
    @@media (max-width: 768px) {
        .card-body {
            padding: 0.75rem;
        }

        .table {
            font-size: 0.85rem;
        }

        .btn-block {
            font-size: 1rem;
            padding: 10px;
        }
    }
    /* Mejorar visualización de alertas de pedidos listos */
    .callout.callout-success {
        border-left: 5px solid #28a745;
        background-color: #d4edda !important;
        animation: pulse 1s infinite;
    }

    /* Modo oscuro */
    body.dark-mode .callout.callout-success {
        background-color: #063529 !important;
    }

    @@keyframes pulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7);
        }

        50% {
            box-shadow: 0 0 0 10px rgba(40, 167, 69, 0);
        }
    }

    .callout h5 {
        color: #155724 !important;
        font-size: 1.3rem;
    }

    body.dark-mode .callout h5 {
        color: #28a745 !important;
    }

    .callout p {
        color: #155724 !important;
    }

    body.dark-mode .callout p {
        color: #d4edda !important;
    }

    .callout .btn-lg {
        font-size: 1.1rem;
        padding: 12px;
    }

</style>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1><i class="fas fa-clipboard-list"></i> Mis Pedidos</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item active">Pedidos Activos</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <!-- Info del Mesero -->
            <!-- Info del Mesero -->
            <div class="row mb-2">
                <div class="col-12">
                    <div class="small-box bg-dark">
                        <div class="inner p-2">
                            <p class="mb-0"><i class="fas fa-user"></i> <strong>@ViewBag.NombreMesero</strong> | ID: @ViewBag.MeseroId</p>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Botón Nuevo Pedido -->
            <div class="row mb-3">
                <div class="col-12">
                    <a href="@Url.Action("NuevoPedido", "Mesero")" class="btn btn-success btn-lg btn-block">
                        <i class="fas fa-plus-circle"></i> Nuevo Pedido
                    </a>
                </div>
            </div>

            <!-- Pedidos Listos (Alertas) -->
            <div id="pedidosListos" class="row">
                <!-- Los pedidos listos se cargarán aquí -->
            </div>

            <!-- Pedidos Activos -->
            <div class="row" id="pedidosContainer">
                <!-- Los pedidos se cargarán aquí -->
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/AdminLTE/plugins/sweetalert2/sweetalert2.min.js"></script>
    <script>
        var previousEstados = {};
        var pedidosListos = {};

        $(document).ready(function () {
            // Solicitar permisos de notificación al cargar
            solicitarPermisosNotificacion();

            loadPedidos();
            setInterval(loadPedidos, 2000);
        });


        function loadPedidos() {
            $.ajax({
                url: '@Url.Action("ObtenerPedidosMesero", "Mesero")',
                type: 'GET',
                success: function (data) {
                    renderPedidos(data);
                },
                error: function (xhr, status, error) {
                    console.log('Error al cargar datos:', error);
                }
            });
        }

        function renderPedidos(items) {
            var container = $('#pedidosContainer');
            container.empty();

            if (items.length === 0) {
                container.append('<div class="col-12"><div class="alert alert-info"><i class="fas fa-info-circle"></i> No tienes pedidos activos</div></div>');
                return;
            }

            $.each(items, function (index, item) {
                var estadoColor = item.estado === 'Listo' ? 'success' :
                                 item.estado === 'En Preparación' ? 'warning' : 'info';
                var estadoIcon = item.estado === 'Listo' ? 'check-circle' :
                                item.estado === 'En Preparación' ? 'clock' : 'hourglass-half';

                var card = `
                    <div class="col-12 col-md-6 col-lg-4 mb-3">
                        <div class="card card-${estadoColor} card-outline">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fas fa-utensils"></i> Mesa ${item.numeroMesa}
                                </h3>
                                <div class="card-tools">
                                    <span class="badge badge-${estadoColor}">
                                        <i class="fas fa-${estadoIcon}"></i> ${item.estado}
                                    </span>
                                </div>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-2">
                                    <dt class="col-5">Pedido #:</dt>
                                    <dd class="col-7">${item.id}</dd>
                                </dl>

                                <table class="table table-sm table-hover">
                                    <thead>
                                        <tr>
                                            <th>Plato</th>
                                            <th class="text-center">Cant.</th>
                                            <th class="text-right">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${item.detalles.map(d => `
                                            <tr>
                                                <td>
                                                    ${d.nombre}
                                                    ${d.comentario ? `<br><em class="text-muted small">${d.comentario}</em>` : ''}
                                                </td>
                                                <td class="text-center">${d.cantidad}</td>
                                                <td class="text-right">$${parseInt(d.subtotal).toLocaleString('es-CO')}</td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                </table>

                                <div class="totales">
                                    <div class="row">
                                        <div class="col-6">Subtotal:</div>
                                        <div class="col-6 text-right">$${parseInt(item.subtotal).toLocaleString('es-CO')}</div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">IVA (19%):</div>
                                        <div class="col-6 text-right">$${parseInt(item.iva).toLocaleString('es-CO')}</div>
                                    </div>
                                    <hr>
                                    <div class="row">
                                        <div class="col-6"><strong>Total:</strong></div>
                                        <div class="col-6 text-right"><strong class="text-lg">$${parseInt(item.total).toLocaleString('es-CO')}</strong></div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <a href="@Url.Action("EditarPedido", "Mesero")?pedidoId=${item.id}" class="btn btn-warning btn-block">
                                    <i class="fas fa-edit"></i> Editar Pedido
                                </a>
                            </div>
                        </div>
                    </div>
                `;

                container.append(card);

                // Detectar cambios de estado
                var estado = item.estado;
                if (estado === 'Listo' && !item.aceptado && previousEstados[item.id] !== 'Listo' && !pedidosListos[item.id]) {
                    pedidosListos[item.id] = item;
                    renderPedidosListos();
                }
                previousEstados[item.id] = estado;
            });
        }

                function renderPedidosListos() {
            var listosContainer = $('#pedidosListos');
            listosContainer.empty();

            if (Object.keys(pedidosListos).length === 0) {
                return;
            }

            $.each(pedidosListos, function (id, item) {
                var alert = `
                    <div class="col-12 mb-3">
                        <div class="callout callout-success">
                            <h5><i class="fas fa-check-circle"></i> Pedido Listo!</h5>
                            <p class="mb-3">El pedido de la <strong>Mesa ${item.numeroMesa}</strong> está listo para entregar.</p>
                            <button class="btn btn-success btn-lg btn-block" onclick="aceptarPedido(${id})">
                                <i class="fas fa-check"></i> Marcar como Entregado
                            </button>
                        </div>
                    </div>
                `;
                listosContainer.append(alert);

                // Mostrar notificación del sistema
                mostrarNotificacion('Pedido Listo!', `Mesa ${item.numeroMesa} - Tu pedido está listo`);


                // Vibrar dispositivo (doble seguridad)
                vibrar();
            });
        }

        // Función para solicitar permisos de notificación
        function solicitarPermisosNotificacion() {
            if (!("Notification" in window)) {
                console.log("Este navegador no soporta notificaciones");
                return;
            }

            if (Notification.permission === "default") {
                Notification.requestPermission().then(function(permission) {
                    if (permission === "granted") {
                        console.log("Permisos de notificación concedidos");
                        // Mostrar notificación de prueba
                        new Notification("QuickTable", {
                            body: "Las notificaciones están activadas",
                            icon: '/img/Logo.png',
                            vibrate: [200, 100, 200]
                        });
                    }
                });
            }
        }

        // Función para mostrar notificación del sistema
        function mostrarNotificacion(titulo, mensaje) {
            if (!("Notification" in window)) {
                console.log("Este navegador no soporta notificaciones");
                return;
            }

            if (Notification.permission === "granted") {
                var notification = new Notification(titulo, {
                    body: mensaje,
                    icon: '/img/Logo.png',
                    vibrate: [300, 100, 300, 100, 300],
                    requireInteraction: true,
                    tag: 'pedido-' + Date.now(),
                    silent: false
                });

                notification.onclick = function() {
                    window.focus();
                    notification.close();
                };

                // Vibrar también desde el navegador
                vibrar();
            } else if (Notification.permission === "default") {
                Notification.requestPermission().then(function(permission) {
                    if (permission === "granted") {
                        mostrarNotificacion(titulo, mensaje);
                    } else {
                        console.log("Permiso de notificación denegado");
                    }
                });
            } else {
                console.log("Permiso de notificación denegado");
            }
        }


        // Función para vibrar el dispositivo
        function vibrar() {
            if ("vibrate" in navigator) {
                navigator.vibrate([200, 100, 200, 100, 200]);
            }
        }

        function aceptarPedido(pedidoId) {
            $.post('@Url.Action("MarcarPedidoAceptado", "Mesero")', { pedidoId: pedidoId })
                .done(function () {
                    delete pedidosListos[pedidoId];
                    renderPedidosListos();
                    toastr.success('Pedido marcado como entregado');
                })
                .fail(function () {
                    toastr.error('Error al actualizar el pedido');
                });
        }
    </script>


}
