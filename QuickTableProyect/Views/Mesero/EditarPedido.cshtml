@model List<QuickTableProyect.Dominio.MenuItem>
@{
    ViewData["Title"] = "Editar Pedido";
}
<style>
    .card {
        transition: transform 0.2s;
    }

        .card:hover {
            transform: translateY(-3px);
        }

    .border-primary {
        border-width: 2px;
    }

    .fixed-bottom {
        z-index: 1000;
    }

    textarea {
        resize: none;
    }
</style>


<div class="container-fluid">
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-warning text-white">
            <h5 class="mb-0">@ViewData["Title"]</h5>
            <small>Mesero: @ViewData["MeseroNombre"] (ID: @ViewData["MeseroId"])</small>
            <h4 class="mb-0 mt-2">Total: $<span id="totalPedido">0</span></h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-6 mb-2">
                    <label for="searchBar" class="form-label">Buscar Plato</label>
                    <input type="text" class="form-control" id="searchBar" placeholder="Buscar por nombre" oninput="filterItems()" />
                </div>
                <div class="col-12 col-md-6 mb-2">
                    <label for="categoryDropdown" class="form-label">Categoría</label>
                    <select id="categoryDropdown" class="form-control" onchange="filterItems()">
                        <option value="">Todas las categorías</option>
                        @foreach (var categoria in ViewBag.Categorias)
                        {
                            <option value="@categoria">@categoria</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div id="menuItemsContainer" class="row">
        @foreach (var item in Model)
        {
            int cantidadExistente = ViewBag.DetallesPedido.ContainsKey(item.Id) ? ViewBag.DetallesPedido[item.Id] : 0;

            <div class="col-12 col-sm-6 col-lg-4 mb-2 menu-item-card" data-name="@item.Nombre" data-category="@item.Categoria" data-id="@item.Id" data-precio="@item.Precio">
                <div class="card shadow-sm @(cantidadExistente > 0 ? "border-primary" : "")">
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="mb-0 text-primary">@item.Nombre</h6>
                                <small class="text-white-50">@item.Descripcion</small>

                            </div>
                            <h5 class="mb-0 text-success">$@item.Precio.ToString("N0")</h5>
                        </div>

                        <div class="d-flex align-items-center mb-2">
                            <button class="btn btn-outline-danger btn-sm" style="width: 35px; height: 35px;" onclick="decreaseQuantity('@item.Id')">
                                <i class="fas fa-minus"></i>
                            </button>
                            <input type="text" id="quantity-@item.Id" value="@cantidadExistente" class="form-control text-center mx-2" style="width: 50px; font-weight: bold;" readonly />
                            <button class="btn btn-outline-success btn-sm" style="width: 35px; height: 35px;" onclick="increaseQuantity('@item.Id')">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>

                        <textarea id="comment-@item.Id" class="form-control form-control-sm" rows="1" placeholder="Observaciones" style="font-size: 0.85rem;"></textarea>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="fixed-bottom bg-white border-top p-2 shadow">
        <div class="container-fluid">
            <div class="row">
                <div class="col-6">
                    <a href="@Url.Action("Index", "Mesero")" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-times"></i> Cancelar
                    </a>
                </div>
                <div class="col-6">
                    <button class="btn btn-warning w-100" onclick="confirmarPedido()">
                        <i class="fas fa-save"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div style="height: 60px;"></div>

</div>

<script>
    function filterItems() {
        const searchQuery = document.getElementById("searchBar").value.toLowerCase();
        const selectedCategory = document.getElementById("categoryDropdown").value;
        const cards = document.querySelectorAll(".menu-item-card");

        cards.forEach(card => {
            const itemName = card.getAttribute("data-name").toLowerCase();
            const itemCategory = card.getAttribute("data-category");

            const matchesSearch = !searchQuery || itemName.includes(searchQuery);
            const matchesCategory = !selectedCategory || itemCategory === selectedCategory;

            card.style.display = (matchesSearch && matchesCategory) ? "" : "none";
        });
    }

    function calculateTotal() {
        let total = 0;
        const cards = document.querySelectorAll(".menu-item-card");

        cards.forEach(card => {
            const itemId = card.getAttribute("data-id");
            const precio = parseFloat(card.getAttribute("data-precio"));
            const cantidad = parseInt(document.getElementById("quantity-" + itemId).value || 0);

            total += precio * cantidad;
        });

        document.getElementById("totalPedido").innerText = total.toLocaleString();
    }

    function increaseQuantity(itemId) {
        const quantityInput = document.getElementById("quantity-" + itemId);
        quantityInput.value = parseInt(quantityInput.value || 0) + 1;
        calculateTotal();
    }

    function decreaseQuantity(itemId) {
        const quantityInput = document.getElementById("quantity-" + itemId);
        const currentQuantity = parseInt(quantityInput.value || 0);
        if (currentQuantity > 0) {
            quantityInput.value = currentQuantity - 1;
            calculateTotal();
        }
    }

    function confirmarPedido() {
        const pedidoId = @ViewData["PedidoId"];
        const items = [];
        const cards = document.querySelectorAll(".menu-item-card");

        cards.forEach(card => {
            const itemId = card.getAttribute("data-id");
            const quantity = parseInt(document.getElementById("quantity-" + itemId).value);
            if (quantity > 0) {
                items.push({
                    menuItemId: itemId,
                    cantidad: quantity,
                    comentario: document.getElementById("comment-" + itemId).value
                });
            }
        });

        if (items.length === 0) {
            alert("Selecciona al menos un plato para el pedido.");
            return;
        }

        fetch(`@Url.Action("ConfirmarCambios", "Mesero")?pedidoId=${pedidoId}`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(items)
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '@Url.Action("Index", "Mesero")';
                } else {
                    alert(data.message);
                }
            })
            .catch(error => console.error("Error en la confirmación del pedido:", error));
    }

    document.addEventListener("DOMContentLoaded", () => {
        calculateTotal();
    });
</script>

